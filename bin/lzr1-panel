#!/usr/bin/env zsh
# lzr1-panel: Claude Code sessions running in tmux on your machines, listed by profile in a clickable panel on the
# left, with a viewer on the right that shows the session you pick.
#
#   lzr1-panel open                                  panel + viewer (Ghostty split on macOS, else a tmux layout)
#   lzr1-panel start PROFILE opus|sonnet NAME [args] start a detached Claude session on PROFILE; a NAME that is a
#                                                    folder under the profile's repos opens in it, else in its root
#   lzr1-panel list                                  print every profile's sessions, then your open PRs
#   lzr1-panel prs                                   your open pull requests (the GitHub account on this machine)
#   lzr1-panel doctor                                check everything the panel needs, with the fix for what is missing
#   lzr1-panel profile list|show|add|test|remove     manage profiles (lzr1-panel profile help)
#   lzr1-panel keys                                  the panel's keys
#   lzr1-panel splash                                the opening animation (LZR1_SPLASH=0 skips it everywhere)
#
# Profiles live in ~/.config/lzr1-panel/profiles/<name>.conf, outside the repository: hosts, keys and paths are yours.
emulate -L zsh
setopt pipe_fail extended_glob
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

VERSION=0.1.0
SELF=${0:A}
CONFIG=${LZR1_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/lzr1-panel}
PROFILES=$CONFIG/profiles
STATE=${XDG_CACHE_HOME:-$HOME/.cache}/lzr1-panel
PANEL_W=${LZR1_PANEL_WIDTH:-56}  # the panel's columns
MENU_BUTTON=${LZR1_MENU_BUTTON:-right}  # the mouse button that opens a row's menu: right or left
mkdir -p $PROFILES $STATE
chmod 700 $CONFIG $PROFILES 2>/dev/null  # profiles hold hosts and key paths

die() { print -ru2 -- "lzr1-panel: $*"; exit 1 }

source ${SELF:h:h}/lib/splash.zsh

# ---- profiles -------------------------------------------------------------------------------------------------------

# A profile is KEY=value lines, read as data (never sourced):
#   type=local|ssh  host=user@host  key=~/.ssh/id  port=22  root=~/work  repos=~/work/repos  claude=/path/to/claude
load() {
  local f=$PROFILES/$1.conf k v
  [[ -n $1 && -r $f ]] || { print -ru2 -- "lzr1-panel: no profile '$1' (see: lzr1-panel profile list)"; return 1 }
  P_NAME=$1 P_TYPE= P_HOST= P_KEY= P_PORT= P_ROOT= P_REPOS= P_CLAUDE=
  while IFS='=' read -r k v; do
    case $k in
      type) P_TYPE=$v ;; host) P_HOST=$v ;; key) P_KEY=${v/#\~/$HOME} ;; port) P_PORT=$v ;;
      root) P_ROOT=$v ;; repos) P_REPOS=$v ;; claude) P_CLAUDE=$v ;;
    esac
  done <$f
  [[ $P_TYPE == (local|ssh) ]] || { print -ru2 -- "lzr1-panel: profile '$1' needs type=local or type=ssh"; return 1 }
  [[ $P_TYPE == local || -n $P_HOST ]] || { print -ru2 -- "lzr1-panel: profile '$1' needs host="; return 1 }
  : ${P_CLAUDE:=claude}
  return 0
}

profiles() { local f; for f in $PROFILES/*.conf(N); do print -r -- ${f:t:r}; done }

# on [-t] SCRIPT ARGS...: runs a POSIX sh script on the loaded profile's machine; -t gives it a terminal.
on() {
  local tty=; [[ $1 == -t ]] && { tty=1; shift }
  local script=$1; shift
  if [[ $P_TYPE == local ]]; then
    # Not the tmux this panel may be running in: the machine's own default server.
    env -u TMUX -u TMUX_PANE sh -c "$script" sh "$@"
    return
  fi
  mkdir -p ~/.ssh/cm
  # One shared connection per machine keeps refreshes and switches fast.
  local -a ssh=(ssh -o BatchMode=yes -o ConnectTimeout=5 -o ControlMaster=auto
                -o "ControlPath=$HOME/.ssh/cm/lzr1-%C" -o ControlPersist=10m)
  [[ -n $P_KEY ]] && ssh+=(-i $P_KEY)
  [[ -n $P_PORT ]] && ssh+=(-p $P_PORT)
  if [[ -n $tty ]]; then
    # The machine may not know this terminal's TERM (xterm-ghostty, say); tmux needs one it knows.
    TERM=xterm-256color $ssh -t $P_HOST "sh -c ${(qq)script} sh ${(j: :)${(qq)@}}"
  else
    $ssh $P_HOST "sh -c ${(qq)script} sh ${(j: :)${(qq)@}}"
  fi
}

# Shared by the scripts below: expands a leading ~ on the machine that runs them.
EXP='exp() { case $1 in "~"|"~/"*) printf "%s" "$HOME${1#"~"}" ;; *) printf "%s" "$1" ;; esac; }
'

# Run before attaching a viewer, on the machine: with tmux's mouse on, a drag selects in tmux, out of the terminal's
# reach, and the selection used to vanish on release with Cmd+C left nothing to copy. Now releasing the mouse copies
# the selection and keeps it shown, Ctrl+C copies it and leaves copy mode, and the copy reaches this computer's
# clipboard: through pbcopy on a Mac, and through the terminal (OSC 52) from any machine, SSH included.
CLIP='tmux set -s set-clipboard on 2>/dev/null
tmux set -s "terminal-features[90]" "*:clipboard" 2>/dev/null
c=; command -v pbcopy >/dev/null 2>&1 && c=pbcopy
for t in copy-mode copy-mode-vi; do
  tmux bind -T $t MouseDragEnd1Pane send -X copy-pipe-no-clear $c 2>/dev/null
  tmux bind -T $t C-c send -X copy-pipe-and-cancel $c 2>/dev/null
done
'

# One record per session back to the panel, fields split by \037 (empty fields survive it, unlike a tab):
# name state attached idle-seconds rc-link model folder task branch changed-files waiting-for
LIST_SCRIPT='
  now=$(date +%s) us=$(printf "\037") host=$(hostname)
  # tmux escapes control characters in -F output, so its fields split on "|"; the task title comes last, where a "|"
  # inside it stays put. Session names cannot contain "|" (lzr1-panel refuses them).
  tmux list-sessions -F "#{session_name}|#{session_attached}|#{session_activity}|#{@rc_url}|#{@lzr1_model}|#{pane_current_path}|#{pane_title}" 2>/dev/null |
  while IFS="|" read -r name att act url model dir title; do
    full=$(tmux capture-pane -p -J -t "=$name:" 2>/dev/null)
    screen=$(printf "%s\n" "$full" | tail -25)
    if printf "%s" "$screen" | grep -q "esc to interrupt"; then st=work
    elif printf "%s" "$screen" | grep -qE "Enter to select|Do you want to|Would you like to proceed|Claude exited"; then st=wait
    else st=idle; fi
    # The newest link on screen wins: a resumed conversation gets a new one.
    new=$(printf "%s" "$full" | grep -o "https://claude.ai/code/session_[A-Za-z0-9]*" | tail -1)
    if [ -n "$new" ] && [ "$new" != "$url" ]; then url=$new; tmux set-option -t "=$name:" @rc_url "$url"; fi
    # Sessions lzr1-panel started carry their model; others show it in Claude Code'"'"'s header.
    [ -n "$model" ] || model=$(printf "%s\n" "$full" | head -8 | grep -oE "Opus|Sonnet|Haiku|Fable" | head -1 | tr "A-Z" "a-z")
    # Claude titles the terminal with its current task, after a spinner glyph.
    title=$(printf "%s" "$title" | sed "s/^[^[:alnum:]]*//")
    case $title in "$host"|"$host".*|"Claude Code"|"") title= ;; esac
    branch= changed=
    if [ -n "$dir" ] && b=$(git -C "$dir" branch --show-current 2>/dev/null); then
      branch=${b:-detached}; changed=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d " ")
    fi
    waitfor=
    if [ $st = wait ]; then
      if printf "%s" "$screen" | grep -q "Claude exited"; then waitfor="Claude exited · Enter resumes"
      else
        waitfor=$(printf "%s\n" "$screen" | grep -E "Do you want|Would you like|\?[[:space:]│]*$" | tail -1 | sed "s/^[[:space:]│╭╰|]*//; s/[[:space:]│╮╯|]*$//")
        [ -n "$waitfor" ] || waitfor="waiting on you"
      fi
    fi
    printf "%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s\n" "$name" "$st" "$att" "$((now - act))" "$url" "$model" "$dir" "$title" "$branch" "$changed" "$waitfor"
  done'

# ---- profile management ---------------------------------------------------------------------------------------------

profile_help() {
  cat <<'EOF'
lzr1-panel profile list
lzr1-panel profile show NAME
lzr1-panel profile add                                   guided: asks for everything
lzr1-panel profile add NAME --local --repos PATH [--root PATH] [--claude PATH]
lzr1-panel profile add NAME --ssh USER@HOST --repos PATH [--key FILE] [--port N] [--root PATH] [--claude PATH]
lzr1-panel profile test NAME                             reach it, find tmux and claude, check the folders
lzr1-panel profile remove NAME

NAME: lowercase letters, digits and dashes (oracle-server, macbook-pro-lazari).
--repos: the folder holding your repositories; a session named like one of them opens inside it.
--root:  where any other session opens (default: --repos).
Paths may start with ~, read on the profile's machine.
EOF
}

profile_test() {
  load $1 || return 1
  print -r -- "profile $1 ($P_TYPE${P_HOST:+ $P_HOST})"
  local out
  out=$(on "$EXP"'
    printf "reach=ok\n"
    printf "tmux=%s\n" "$(command -v tmux || echo missing)"
    c=$(exp "$1"); case $c in */*) [ -x "$c" ] || c=missing ;; *) c=$(command -v "$c" || echo missing) ;; esac
    printf "claude=%s\n" "$c"
    r=$(exp "$2"); [ -d "$r" ] && printf "repos=%s (%s folders)\n" "$r" "$(ls -1 "$r" | wc -l | tr -d " ")" || printf "repos=%s missing\n" "$r"
    o=$(exp "$3"); [ -d "$o" ] && printf "root=%s\n" "$o" || printf "root=%s missing\n" "$o"
  ' "$P_CLAUDE" "${P_REPOS:-~}" "${P_ROOT:-${P_REPOS:-~}}" 2>&1) || { print -r -- "  cannot reach it: $out"; return 1 }
  local bad=0 line
  for line in ${(f)out}; do
    print -r -- "  ${line/=/: }"
    [[ $line == *missing* ]] && bad=1
  done
  (( bad )) && print -r -- "  fix the missing items above (tmux and Claude Code must be installed there)"
  return $bad
}

profile_add() {
  local name type host key port repos root claude
  if (( $# == 0 )); then
    # Guided: the same questions an agent asks, then the same command.
    print "New lzr1-panel profile (Claude Code sessions only, for now)"
    read -r "name?  Profile name (e.g. macbook-pro-lazari): "
    print "  Target: 1) this computer   2) another machine over SSH"
    read -r "type?  Choose 1 or 2: "
    if [[ $type == 2 ]]; then
      type=ssh
      read -r "host?  SSH user@host: "
      read -r "key?  SSH key file (empty: your SSH defaults): "
      read -r "port?  SSH port (empty: 22): "
    else
      type=local
    fi
    read -r "repos?  Folder with your repositories (e.g. ~/Github/lerian): "
    read -r "root?  Folder for sessions that are not a repository (empty: same as above): "
  else
    name=$1; shift
    while (( $# )); do
      case $1 in
        --local) type=local ;;
        --ssh) type=ssh host=$2; shift ;;
        --key) key=$2; shift ;;
        --port) port=$2; shift ;;
        --repos) repos=$2; shift ;;
        --root) root=$2; shift ;;
        --claude) claude=$2; shift ;;
        *) die "profile add: unknown option $1" ;;
      esac
      shift
    done
  fi
  [[ $name == [a-z0-9][a-z0-9-]# ]] || die "profile name: lowercase letters, digits and dashes"
  [[ $type == (local|ssh) ]] || die "profile add: choose --local or --ssh USER@HOST"
  [[ $type == local || -n $host ]] || die "profile add: --ssh needs USER@HOST"
  [[ -n $repos ]] || die "profile add: --repos PATH is required"
  [[ -e $PROFILES/$name.conf ]] && die "profile '$name' exists (lzr1-panel profile remove $name first)"
  [[ $key == \~* ]] && key=$HOME${key#\~}
  [[ -z $key || -r $key ]] || die "SSH key not readable: $key"
  # Store a path to claude that works without a login shell: tmux starts it with a bare PATH.
  if [[ -z $claude ]]; then
    P_TYPE=$type P_HOST=$host P_KEY=$key P_PORT=$port
    claude=$(on 'command -v claude 2>/dev/null || { [ -x "$HOME/.local/bin/claude" ] && echo "$HOME/.local/bin/claude"; }' 2>/dev/null)
    [[ -n $claude ]] || die "Claude Code not found on that machine (install it there, or pass --claude PATH)"
  fi
  {
    print -r -- "# lzr1-panel profile: $name (written $(date +%Y-%m-%d)). Keep it out of git."
    print -r -- "type=$type"
    [[ -n $host ]] && print -r -- "host=$host"
    [[ -n $key ]] && print -r -- "key=$key"
    [[ -n $port ]] && print -r -- "port=$port"
    print -r -- "repos=$repos"
    print -r -- "root=${root:-$repos}"
    print -r -- "claude=$claude"
  } >$PROFILES/$name.conf
  chmod 600 $PROFILES/$name.conf
  print -r -- "saved $PROFILES/$name.conf"
  profile_test $name
}

# ---- pull requests --------------------------------------------------------------------------------------------------

# The open pull requests of the GitHub account on this machine, newest first: the account gh is signed in to, or,
# without gh, the one this machine's SSH key belongs to (public PRs only, and it needs jq). The first line is
# LOGIN<us>SOURCE; then one record per PR, fields split by \037:
# repository number title url draft branch review-decision checks updated
prs_fetch() {
  local login
  if command -v gh >/dev/null && gh api graphql -f query='{ viewer { login }
      search(query: "is:pr is:open author:@me sort:updated-desc", type: ISSUE, first: 20) { nodes { ... on PullRequest {
        number title url isDraft updatedAt headRefName reviewDecision repository { nameWithOwner }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } } } }' --jq '
      "\(.data.viewer.login)\u001fgh",
      (.data.search.nodes[] | [.repository.nameWithOwner, (.number | tostring), .title, .url, (.isDraft | tostring),
        .headRefName, (.reviewDecision // ""), (.commits.nodes[0].commit.statusCheckRollup.state // ""), .updatedAt]
        | join("\u001f"))' 2>/dev/null; then
    return 0
  fi
  # GitHub greets an SSH key with its account: "Hi LOGIN! You've successfully authenticated, ..."
  login=$(ssh -T -o BatchMode=yes -o ConnectTimeout=5 git@github.com 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p')
  [[ -n $login ]] && command -v jq >/dev/null || return 1
  print -r -- "$login"$'\037'ssh
  curl -sf -m 10 "https://api.github.com/search/issues?q=is:pr+is:open+author:$login&sort=updated&per_page=20" |
    jq -r '.items[] | [(.repository_url | sub(".*/repos/"; "")), (.number | tostring), .title, .html_url,
      (.draft | tostring), "", "", "", .updated_at] | join("\u001f")'
}

# The cached list, refreshed at most once a minute (the search takes about a second); LZR1_PRS=0 turns it off.
# A failed search keeps the last list and waits a minute too.
prs_refresh() {
  [[ ${LZR1_PRS:-1} == 0 ]] && return
  local -a fresh=( $STATE/prs(Nms-60) )
  (( $#fresh )) && return
  prs_fetch >$STATE/prs.$$ && mv $STATE/prs.$$ $STATE/prs || { rm -f $STATE/prs.$$; touch $STATE/prs }
}

# _ago SECONDS: 45s, 12m, 3h or 2d, into REPLY
_ago() {
  if   (( $1 < 60 ));    then REPLY=${1}s
  elif (( $1 < 3600 ));  then REPLY=$(( $1 / 60 ))m
  elif (( $1 < 86400 )); then REPLY=$(( $1 / 3600 ))h
  else REPLY=$(( $1 / 86400 ))d; fi
}

# A PR row's key is +pr/URL; the section heading's is +pr/.
pr_rows() {  # pr_rows WIDTH: the PR section's fzf items, after the sessions (layout 1, cards)
  [[ ${LZR1_PRS:-1} == 0 || ! -s $STATE/prs ]] && return
  local W=$1 D=$'\e[90m' B=$'\e[1m' Y=$'\e[33m' G=$'\e[32m' E=$'\e[31m' M=$'\e[37m' R=$'\e[0m'
  local -a got=( ${(f)"$(<$STATE/prs)"} )
  local login src repo num title url draft branch review checks updated glyph words color hd fl t age pre l1 l2 line
  IFS=$'\037' read -r login src <<<"${got[1]}"
  zmodload zsh/datetime; local TZ=UTC  # GitHub's times are UTC
  hd=" pull requests $login · $src · $(( $#got - 1 )) "
  fl=$(( W - ${#hd} - 1 )); (( fl < 0 )) && fl=0
  print -rn -- "+pr/"$'\t'" ${B}pull requests$R $D$login · $src · $(( $#got - 1 )) ${(l:fl::─:)}$R"$'\0'
  for line in "${(@)got[2,-1]}"; do
    IFS=$'\037' read -r repo num title url draft branch review checks updated <<<"$line"
    # One glyph from the draft flag, the latest commit's checks and the review, worst first.
    if [[ $draft == true ]]; then glyph="$D◌$R" words=draft color=$D
    elif [[ $checks == (FAILURE|ERROR) ]]; then glyph="$E✗$R" words="checks failed" color=$E
    elif [[ $review == CHANGES_REQUESTED ]]; then glyph="$E✗$R" words="changes requested" color=$E
    elif [[ $checks == (PENDING|EXPECTED) ]]; then glyph="$Y⧗$R" words="checks running" color=$Y
    elif [[ $review == REVIEW_REQUIRED ]]; then glyph="$Y⧗$R" words="review required" color=$Y
    elif [[ $checks == SUCCESS ]]; then glyph="$G✓$R" color=$G words="checks passed${${(M)review:#APPROVED}:+ · approved}"
    else glyph="$D·$R" words=${${review:l}//_/ } color=$D; fi
    t=$EPOCHSECONDS; [[ -n $updated ]] && strftime -r -s t '%Y-%m-%dT%H:%M:%SZ' $updated 2>/dev/null
    _ago $(( EPOCHSECONDS - t )); age=$REPLY
    _cut "#$num $title" $(( W - 6 - ${#age} )); l1=" $glyph $M${(r:W - 6 - ${#age}:)REPLY}$R $D$age$R"
    pre="${repo:t}${branch:+ · ⎇ $branch}${words:+ · }"
    _cut "$pre$words" $(( W - 4 ))
    if (( ${#REPLY} > ${#pre} )); then l2="   $D$pre$R$color${REPLY:${#pre}}$R"; else l2="   $D$REPLY$R"; fi
    print -rn -- "+pr/$url"$'\t'"$l1"$'\n'"$l2"$'\0'
  done
}

# ---- panel internals ------------------------------------------------------------------------------------------------

# A row key is PROFILE/SESSION; a profile's heading row is PROFILE/.
split_key() { KP=${1%%/*} KS=${1#*/} }

ghostty() { osascript -e 'tell application "Ghostty"' -e "$1" -e 'end tell' }

mode() { print -rn -- "$(<$STATE/$1.mode)" } 2>/dev/null

browse() { if [[ $OSTYPE == darwin* ]]; then open $1; else xdg-open $1 >/dev/null 2>&1; fi }

# clip TEXT: onto the clipboard of the computer in front of you (pbcopy, wl-copy, xclip, or the terminal's OSC 52)
clip() {
  if command -v pbcopy >/dev/null; then print -rn -- $1 | pbcopy
  elif [[ -n $WAYLAND_DISPLAY ]] && command -v wl-copy >/dev/null; then print -rn -- $1 | wl-copy
  elif [[ -n $DISPLAY ]] && command -v xclip >/dev/null; then print -rn -- $1 | xclip -selection clipboard
  else printf '\e]52;c;%s\a' "$(print -rn -- $1 | base64 | tr -d '\n')" >/dev/tty; fi
}

# _cut TEXT WIDTH: TEXT cut to WIDTH characters with an ellipsis, into REPLY
_cut() { if (( ${#1} > $2 )); then REPLY="${1[1,$2-1]}…"; else REPLY=$1; fi }

# Every profile's sessions, listed in parallel, as NUL-separated fzf items: "KEY<tab>display". The first item is
# the summary heading. A session is three lines (layout A): name with model and age; its task, or what it waits
# for; its branch and repository. Sized to the panel ($FZF_COLUMNS).
list_rows() {
  local -a names=( $(profiles) )
  if (( ! $#names )); then
    print -rn -- $'\t'"no profiles yet"$'\0'
    print -rn -- $'-/\t'$'\e[90m'"run: lzr1-panel profile add"$'\e[0m\0'
    return
  fi
  local tmp=$(mktemp -d) p
  local -a down
  for p in $names; do
    # An offline machine is retried once a minute, so it never slows every refresh.
    down=( $STATE/down-$p(Nms-60) )
    if (( $#down )); then : >$tmp/$p.fail; continue; fi
    ( if load $p && on "$LIST_SCRIPT" >$tmp/$p.out 2>/dev/null; then rm -f $STATE/down-$p
      else : >$tmp/$p.fail; : >$STATE/down-$p; fi ) &
  done
  prs_refresh &
  wait
  local W=$(( ${FZF_COLUMNS:-${COLUMNS:-56}} - 2 )); (( W < 40 )) && W=40
  local -a items got; local n=0 w=0 q=0 i=0 line kind glyph right l1 l2 l3
  local name st att age url model dir title branch changed waitfor
  local D=$'\e[90m' B=$'\e[1m' C=$'\e[36m' Y=$'\e[33m' G=$'\e[32m' M=$'\e[37m' R=$'\e[0m'
  for p in $names; do
    # A profile whose machine does not answer is left out until it does.
    [[ -e $tmp/$p.fail ]] && continue
    load $p 2>/dev/null; kind=$P_TYPE
    got=( ${(f)"$(<$tmp/$p.out)"} )
    cp $tmp/$p.out $STATE/raw-$p  # the menu reads a session's details from here
    local hd=" $p $kind · online · $#got " fl
    fl=$(( W - ${#hd} - 1 )); (( fl < 0 )) && fl=0
    items+=( "$p/"$'\t'" $B$p$R $D$kind · online · $#got ${(l:fl::─:)}$R" )
    for line in $got; do
      IFS=$'\037' read -r name st att age url model dir title branch changed waitfor <<<"$line"
      (( n++ ))
      case $st in
        work) (( w++ )); glyph="$C▶$R" ;;
        wait) (( q++ )); glyph="$Y⧗$R" ;;
        *)    (( i++ )); glyph="$D·$R" ;;
      esac
      _ago $age; age=$REPLY
      right="${model:+$model · }$age"
      _cut $name $(( W - 6 - ${#right} )); l1=" $glyph ${(r:W - 6 - ${#right}:)REPLY} $C${model}$R${model:+$D · }$D$age$R $( (( att > 0 )) && print -n "$G●$R" || print -n ' ')"
      if [[ -n $waitfor ]]; then _cut "⧗ $waitfor" $(( W - 4 )); l2="   $Y$REPLY$R"
      elif [[ -n $title ]]; then _cut $title $(( W - 4 )); l2="   $M$REPLY$R"
      else l2="   ${D}no task yet$R"; fi
      if [[ -n $branch ]]; then _cut "⎇ $branch${${changed:#0}:+ +$changed} · ${dir:t}" $(( W - 4 ))
      else _cut "${dir:t}" $(( W - 4 )); fi
      l3="   $D$REPLY$R"
      items+=( "$p/$name"$'\t'"$l1"$'\n'"$l2"$'\n'"$l3" )
    done
  done
  rm -rf $tmp
  print -rn -- $'\t'"$n sessions · $w▶ $q⧗ $i·"$'\0'
  (( $#items )) && print -rn -- ${(pj:\0:)items}$'\0'
  pr_rows $W
}

viewer_detach() {  # viewer_detach ID KEY: detach the viewer's client from KEY's machine
  split_key $2; load $KP 2>/dev/null || return 0
  on 'c=$(cat "$HOME/.cache/lzr1-panel-viewer/$1" 2>/dev/null); [ -n "$c" ] && tmux detach-client -t "$c" 2>/dev/null; true' $1
}

# ---- commands -------------------------------------------------------------------------------------------------------

case $1 in

start)  # start PROFILE opus|sonnet NAME [claude args]
  load $2 || exit 1
  local model=$3 name=$4
  shift 4 2>/dev/null
  [[ $model == (opus|sonnet) && -n $name ]] || die 'usage: lzr1-panel start PROFILE opus|sonnet NAME [claude args]'
  [[ $name == *[.:/\|]* ]] && die 'session names cannot contain ".", ":", "/" or "|"'
  local claude="${(q)P_CLAUDE} --model $model --dangerously-skip-permissions --effort medium --remote-control ${(q)name} ${(j: :)${(q)@}}"
  # If Claude exits (Ctrl-C twice, /exit, a crash) the session stays and Enter resumes the same conversation.
  # Only typing "end" closes it: Ctrl-C and Ctrl-D, easy to hit by accident in a viewer, do not (the trap is a handler, so Claude and its commands still get Ctrl-C).
  # LZR1_PROMPT is Claude's first message; a resumed conversation does not get it again.
  local cmd="trap : INT; $claude ${LZR1_PROMPT:+${(q)LZR1_PROMPT}}; while :; do printf '\\n  Claude exited. Enter: resume this conversation · type end + Enter: close the session\\n  > '; read -r a || a=; [ \"\$a\" = end ] && break; $claude --continue; done"
  print -r -- "starting: $name on $P_NAME"
  on "$EXP"'
    name=$1 cmd=$2 root=$(exp "$3") repos=$(exp "$4")
    if tmux has-session -t "=$name" 2>/dev/null; then echo "already running"; exit 0; fi
    dir=$root inrepo=
    if [ -n "$repos" ] && [ -d "$repos/$name" ]; then dir=$repos/$name inrepo=1
    # A session about a pull request, REPO-prN, opens in REPO.
    elif [ -n "$repos" ] && [ -d "$repos/${name%-pr*}" ]; then dir=$repos/${name%-pr*} inrepo=1; fi
    [ -d "$dir" ] || dir=$HOME
    echo "folder: $dir"
    tmux new-session -d -s "$name" -c "$dir" -x 200 -y 50 "$cmd" || exit 1
    tmux set-option -t "=$name:" @lzr1_model "$5"
    trusted= i=0
    while [ $i -lt 15 ]; do
      i=$((i + 1)); sleep 1
      tmux has-session -t "=$name" 2>/dev/null || { echo "claude exited right after start"; exit 1; }
      screen=$(tmux capture-pane -p -J -t "=$name:")
      # First run in a repository: Claude asks whether to trust the folder, defaulting to "No, exit".
      if [ -n "$inrepo" ] && [ -z "$trusted" ] && printf "%s" "$screen" | grep -q "Yes, I trust this folder"; then
        tmux send-keys -t "=$name:" Down Enter; trusted=1; echo "trusted the repository folder (first run)"; continue
      fi
      url=$(printf "%s" "$screen" | grep -o "https://claude.ai/code/session_[A-Za-z0-9]*" | tail -1)
      if [ -n "$url" ]; then tmux set-option -t "=$name:" @rc_url "$url"; echo "remote control: $url"; exit 0; fi
    done
    echo "started (Remote Control link not shown yet)"' "$name" "$cmd" "${P_ROOT:-${P_REPOS:-~}}" "$P_REPOS" "$model"
  ;;

prs)  # your open pull requests, fresh
  rm -f $STATE/prs; prs_refresh
  local it; for it in "${(@0)$(pr_rows ${COLUMNS:-80})}"; do [[ -n $it ]] && print -r -- ${it#*$'\t'}; done
  [[ -s $STATE/prs ]] || print -ru2 -- "lzr1-panel: no GitHub account found (sign in with: gh auth login)"
  ;;

doctor)  # checks this computer, GitHub and every profile, with the fix for anything missing
  local bad=0 v login p GC="$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  local -a all=( $(profiles) )
  _ok()   { print -r -- "  ✓ $*" }
  _no()   { print -r -- "  ✗ $*"; bad=1 }
  _hint() { print -r -- "      → $*" }
  autoload -Uz is-at-least
  print "this computer"
  for v in zsh tmux git curl openssl; do
    (( $+commands[$v] )) && _ok $v || { _no "$v is missing"; _hint "./install.sh installs it" }
  done
  v=$(fzf --version 2>/dev/null); v=${v%% *}
  if [[ -n $v ]] && is-at-least 0.74 $v; then _ok "fzf $v"
  else _no "fzf ${v:-is missing} (0.74 or newer is needed)"; _hint "./install.sh installs it"; fi
  if [[ $OSTYPE == darwin* ]]; then
    if [[ -d /Applications/Ghostty.app ]]; then
      _ok "Ghostty"
      if grep -qsF 'performable:ctrl+c=copy_to_clipboard' $GC ~/.config/ghostty/config(|.ghostty)(N); then
        _ok "Ghostty: Ctrl+C copies a selection"
      else print "  · Ghostty: Ctrl+C does not copy yet"; _hint "./install.sh offers it"; fi
    else print "  · no Ghostty: the panel opens as a tmux layout"; fi
  fi
  print "\ngithub (the pull requests under your sessions)"
  if [[ ${LZR1_PRS:-1} == 0 ]]; then print "  · hidden (LZR1_PRS=0)"
  elif (( $+commands[gh] )) && login=$(gh api user -q .login 2>/dev/null); then _ok "gh is signed in as $login"
  else
    login=$(ssh -T -o BatchMode=yes -o ConnectTimeout=5 git@github.com 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p')
    if [[ -n $login ]] && (( $+commands[jq] )); then
      _ok "your SSH key belongs to $login (public PRs only)"; _hint "for every PR, with checks and reviews: gh auth login"
    else
      _no "no GitHub account found"
      (( $+commands[gh] )) && _hint "run: gh auth login" || _hint "./install.sh installs gh and signs you in"
    fi
  fi
  print "\nprofiles"
  (( $#all )) || { _no "no profiles yet"; _hint "lzr1-panel profile add" }
  for p in $all; do profile_test $p | sed 's/^/  /' || bad=1; done
  if (( bad )); then print "\n  something needs fixing: see docs/troubleshooting.md"; else print "\n  all good"; fi
  exit $bad
  ;;

list)
  local it; for it in "${(@0)$(list_rows)}"; do [[ -n $it ]] && print -r -- ${it#*$'\t'}; done
  ;;

_list)  # _list ID: rows for fzf, cached for _pos
  list_rows | tee $STATE/$2.cache
  ;;

profile)
  shift
  case $1 in
    list|ls|'')
      local p; local -a all=( $(profiles) )
      for p in $all; do load $p && print -r -- "$p  $P_TYPE${P_HOST:+  $P_HOST}  repos=$P_REPOS"; done
      (( $#all )) || print "no profiles yet: lzr1-panel profile add"
      ;;
    show) load $2 && { print -r -- "# $PROFILES/$2.conf"; grep -v '^#' $PROFILES/$2.conf } ;;
    add) shift; profile_add "$@" ;;
    test) profile_test $2 ;;
    remove|rm) [[ -e $PROFILES/$2.conf ]] || die "no profile '$2'"; rm -f $PROFILES/$2.conf; print "removed $2" ;;
    *) profile_help ;;
  esac
  ;;

open)  # panel on the left, viewer on the right
  local id=$$ term
  rm -rf $STATE/*(Nmd+1)
  lzr1_splash open
  if [[ $OSTYPE == darwin* && ( $TERM_PROGRAM == ghostty || -n $GHOSTTY_RESOURCES_DIR ) && -z $TMUX ]]; then
    # Ghostty: split this pane; it becomes the viewer.
    term=$(ghostty 'get id of focused terminal of selected tab of front window') || die "cannot script Ghostty"
    print -rn -- ghostty >$STATE/$id.mode
    print -rn -- $term >$STATE/$id.vterm
    ghostty "set cfg to new surface configuration
      set command of cfg to \"$SELF _panel $id\"
      set p to split (terminal id \"$term\") direction left with configuration cfg
      return id of p" >$STATE/$id.me || die "cannot split the Ghostty pane"
    exec $SELF _viewer $id
  fi
  # Anywhere else: a tmux layout on its own server, with no prefix key, so every key reaches the panel,
  # the viewer or Claude; the mouse picks a pane.
  command -v tmux >/dev/null || die "needs tmux"
  local -a T=(tmux -L lzr1 -f /dev/null)
  local sess=lzr1-$id vpane
  $T new-session -d -s $sess -x ${COLUMNS:-200} -y ${LINES:-50} "$SELF _viewer $id" || die "cannot start tmux"
  $T set -g prefix None \; set -g prefix2 None \; set -g mouse on \; set -g status off \; set -g escape-time 10 \
     \; set -g default-terminal tmux-256color \; set -ga terminal-overrides ',*:RGB' \
     \; set -s set-clipboard on \; set -s 'terminal-features[90]' '*:clipboard' >/dev/null  # copies reach the terminal
  vpane=$($T display -p -t $sess '#{pane_id}')
  print -rn -- tmux >$STATE/$id.mode
  print -rn -- $vpane >$STATE/$id.vterm
  $T split-window -hb -l $PANEL_W -t $sess "$SELF _panel $id"
  TMUX= exec $T attach -t $sess
  ;;

_viewer)  # _viewer ID: attaches to whatever the panel picked, waits when nothing is picked
  local id=$2 target
  local tfile=$STATE/$id.target
  trap 'rm -f $tfile $tfile.want $tfile.detached $STATE/$id.vpid' EXIT
  print -rn -- $$ >$STATE/$id.vpid; rmdir $STATE/$id.spawn 2>/dev/null
  printf '\e]2;lzr1 viewer\a'
  while true; do
    target=$(<$tfile 2>/dev/null)
    if [[ -z $target ]]; then
      clear; print -P '\n  %F{8}← pick a session in the panel: click it, or use the arrow keys%f'
      print -P '  %F{8}inside a session, Ctrl-b d leaves it (Ctrl-C goes to Claude)%f'
      until [[ -s $tfile ]]; do sleep 0.3; done
      continue
    fi
    clear
    split_key $target
    if load $KP; then
      # A session the panel just created may still be starting: wait for it (up to 30s), then attach.
      on -t '
        mkdir -p "$HOME/.cache/lzr1-panel-viewer" && tty >"$HOME/.cache/lzr1-panel-viewer/$1"
        n=0
        while ! tmux has-session -t "=$2" 2>/dev/null; do
          [ $n = 0 ] && printf "\n  starting %s ...\n" "$2"
          n=$((n + 1)); [ $n -gt 150 ] && { printf "  %s did not start\n" "$2"; sleep 3; exit 1; }
          sleep 0.2
        done
        '"$CLIP"'
        unset TMUX
        exec tmux attach -t "=$2"' $id $KS
    else
      sleep 3
    fi
    # Detached (Ctrl-b d) or the session ended: wait for the next pick, unless the panel already moved on.
    # The panel's refreshes re-send its highlighted row; .detached keeps them from reattaching it.
    if [[ $(<$tfile 2>/dev/null) == $target ]]; then print -rn -- $target >$tfile.detached; : >$tfile; fi
  done
  ;;

_select)  # _select ID KEY [force]: point the viewer at KEY (debounced, so arrowing through rows stays cheap)
  local id=$2 key=$3 tfile=$STATE/$2.target
  split_key $key
  [[ -z $KP || -z $KS || $KP == +pr ]] && exit 0
  # A click on another row, enter or a new session brings back a viewer pane that was closed.
  if [[ $4 == force || $(<$tfile 2>/dev/null) != $key ]] && ! kill -0 $(<$STATE/$id.vpid 2>/dev/null) 2>/dev/null; then
    print -rn -- $key >$tfile
    $SELF _respawn $id
    exit 0
  fi
  [[ $(<$tfile 2>/dev/null) == $key ]] && exit 0
  # Right after a new session, the panel's refresh briefly re-sends the old row: ignore it for 3s.
  local -a hold=( $STATE/$id.hold(Nms-3) )  # globbed here: [[ ]] does not glob
  [[ $4 != force && -n $hold && $(<$hold) != $key ]] && exit 0
  # The session the viewer was detached from comes back only on enter or a double-click.
  [[ $4 != force && $(<$tfile.detached 2>/dev/null) == $key ]] && exit 0
  rm -f $tfile.detached
  print -rn -- $key >$tfile.want
  sleep 0.35
  [[ $(<$tfile.want 2>/dev/null) == $key ]] || exit 0
  local was=$(<$tfile 2>/dev/null)
  print -rn -- $key >$tfile
  [[ -z $was ]] && exit 0  # an idle viewer picks the target up by itself
  if [[ ${was%%/*} == $KP ]]; then
    # Same machine: switch the attached client in place.
    load $KP && on '
      c=$(cat "$HOME/.cache/lzr1-panel-viewer/$1" 2>/dev/null)
      [ -n "$c" ] && tmux list-clients -F "#{client_tty}" | grep -qx "$c" && tmux switch-client -c "$c" -t "=$2"
      true' $id $KS
  else
    # Another machine: let go of the old one; the viewer then attaches the new target.
    viewer_detach $id $was
  fi
  ;;

_ticker)  # _ticker ID PORT: show the first session in the viewer, then reload the panel every 15s while it is alive
  local id=$2 port=$3
  ( local first i
    for i in {1..50}; do
      first=$(curl -sf -m 2 -H "x-api-key: $FZF_API_KEY" "localhost:$port?limit=200" |
        grep -o '"text":"[^"]*' | sed 's/^"text":"//; s/\\t.*//' | grep -v '/$' | grep '/' | grep -v '^+pr/' | head -1)
      [[ -n $first ]] && { $SELF _select $id $first; break; }
      sleep 0.2
    done
    while sleep 15; do
      curl -sf -m 5 -H "x-api-key: $FZF_API_KEY" -XPOST "localhost:$port" -d "reload($SELF _list $id)" || exit 0
    done ) >/dev/null 2>&1 &!
  ;;

_pos)  # _pos ID PORT KEY: move the panel's highlight to KEY once the panel lists it (tries for ~6s)
  local id=$2 port=$3 key=$4 i line api=(curl -s -m 2 -H "x-api-key: $FZF_API_KEY" "localhost:$3")
  repeat 20; do
    sleep 0.3
    $api -XPOST -d "reload($SELF _list $id)" >/dev/null
    sleep 0.5
    i=0
    local -a its=( "${(@0)$(<$STATE/$id.cache)}" )
    for line in "${(@)its[2,-1]}"; do
      [[ -n $line ]] || continue
      (( i++ )); [[ ${line%%$'\t'*} == $key ]] || continue
      print -rn -- $key >$STATE/$id.target.want
      $api -XPOST -d "pos($i)" >/dev/null; sleep 0.2
      [[ $($api "?limit=1" | grep -o '"current":{[^}]*' ) == *"\"text\":\"$key\\t"* ]] && exit 0
    done
  done
  ;;

_new)  # _new opus|sonnet ID KEY [NAME [PROMPT]]: type a name on KEY's profile (or take NAME); starts in the background,
       # shows it in the viewer; PROMPT is Claude's first message
  local model=$2 id=$3 p=${4%%/*} name=$5 prompt=$6
  # Only the machines that answered on the last refresh.
  local -a all=( ${${(M)${(@0)"$(<$STATE/$id.cache)"}:#[^+/]##/$'\t'*}%%/*} )
  (( $#all )) || all=( $(profiles) )
  [[ -n $p && -e $PROFILES/$p.conf ]] || p=${all[1]}
  if (( $#all > 1 )); then
    # Several machines: confirm which one, starting from the highlighted row's.
    p=$(print -rl -- $p ${all:#$p} | fzf --layout=reverse --prompt="new $model on › " --info=hidden \
          --gutter=' ' --pointer='▌' --highlight-line --color='pointer:yellow,current-fg:bold' \
          --header='click a machine · esc cancels' --header-border=bottom \
          --bind 'left-click:accept,double-click:accept') || exit 0
  fi
  [[ -n $p ]] || { print "no profiles yet: lzr1-panel profile add — press a key"; read -k1 -s; exit 0 }
  load $p || { read -k1 -s; exit 0 }
  # Type a name and press enter, or click a repository. Enter with nothing typed takes the highlighted one.
  local -a picked
  [[ -z $name ]] && picked=( "${(@f)$(on "$EXP"'ls -1 "$(exp "$1")" 2>/dev/null' $P_REPOS |
    fzf --layout=reverse --print-query --prompt="new $model on $p › " --info=hidden --no-sort \
      --gutter=' ' --pointer='▌' --highlight-line --color='pointer:yellow,current-fg:bold' \
      --header=$'type a name ↵ or click a repo\nrepos open in their own folder' \
      --header-border=bottom \
      --bind 'enter:transform:[ -n {q} ] && echo print-query || echo accept' \
      --bind 'tab:replace-query,left-click:accept,double-click:accept,esc:abort')}" )
  [[ -z $name ]] && name=${picked[2]:-${picked[1]}}
  [[ -z $name ]] && exit 0
  if [[ $name == *[.:/\|]* ]]; then
    print -r -- 'session names cannot contain ".", ":", "/" or "|" — press a key'; read -k1 -s; exit 0
  fi
  LZR1_PROMPT=$prompt $SELF start $p $model $name >$STATE/$id.startlog 2>&1 &!
  # Back to the list as soon as tmux has the session; the viewer shows Claude starting in it.
  if ! on 'i=0; while [ $i -lt 100 ]; do tmux has-session -t "=$1" 2>/dev/null && exit 0; i=$((i + 1)); sleep 0.1; done; exit 1' $name; then
    print -r -- "could not start $name:"; cat $STATE/$id.startlog; print "press a key"; read -k1 -s; exit 0
  fi
  print -rn -- "$p/$name" >$STATE/$id.hold
  $SELF _select $id "$p/$name" force
  # The panel reloads after this returns; then its highlight moves to the new row.
  $SELF _pos $id $FZF_PORT "$p/$name" >/dev/null 2>&1 &!
  ;;

_respawn)  # _respawn ID: open a new viewer pane to the right of the panel
  local id=$2 me=$(<$STATE/$2.me 2>/dev/null)
  [[ -z $me ]] && exit 0
  rmdir $STATE/$id.spawn(Nms+10) 2>/dev/null
  mkdir $STATE/$id.spawn 2>/dev/null || exit 0
  if [[ $(mode $id) == tmux ]]; then
    tmux -L lzr1 split-window -h -t $me -P -F '#{pane_id}' "$SELF _viewer $id" >$STATE/$id.vterm.new
  else
    ghostty "set cfg to new surface configuration
      set command of cfg to \"$SELF _viewer $id\"
      set v to split (terminal id \"$me\") direction right with configuration cfg
      return id of v" >$STATE/$id.vterm.new
  fi && mv $STATE/$id.vterm.new $STATE/$id.vterm
  ;;

_focus)  # _focus ID: move the keyboard to the viewer
  local vt=$(<$STATE/$2.vterm 2>/dev/null)
  [[ -z $vt ]] && exit 0
  if [[ $(mode $2) == tmux ]]; then tmux -L lzr1 select-pane -t $vt
  else ghostty "focus (terminal id \"$vt\")" >/dev/null; fi
  ;;

_url)  # _url KEY: the session's Remote Control link
  split_key $2; [[ -n $KS ]] || exit 0
  load $KP && on 'tmux show-options -v -t "=$1:" @rc_url 2>/dev/null' $KS
  ;;

_open_url)  # _open_url KEY: a session's Remote Control link, or a PR
  local u
  split_key $2
  if [[ $KP == +pr ]]; then u=$KS; else u=$($SELF _url $2); fi
  [[ -n $u ]] && browse $u
  ;;

_go)  # _go ID KEY: enter and double-click; a session goes to the viewer with the keyboard, a PR opens in the browser
  split_key $3
  if [[ $KP == +pr ]]; then [[ -n $KS ]] && browse $KS
  else $SELF _select $2 $3 force; $SELF _focus $2; fi
  ;;

_kill)  # _kill KEY
  split_key $2; [[ -n $KS && $KP != +pr ]] || exit 0
  print -rn -- "End session ${(qq)KS} on $KP? Claude stops there. [y/N] "
  read -q && { load $KP && on 'tmux kill-session -t "=$1"' $KS }
  print
  ;;

_tab)  # _tab ID KEY: the session in a new Ghostty tab (in the tmux layout: switch the viewer to it)
  split_key $3; [[ -n $KS && $KP != +pr ]] || exit 0
  if [[ $(mode $2) == ghostty ]]; then
    ghostty "set cfg to new surface configuration
      set command of cfg to \"$SELF _attach ${(q)3}\"
      new tab in front window with configuration cfg" >/dev/null
  else
    $SELF _select $2 $3 force; $SELF _focus $2
  fi
  ;;

_menu)  # _menu ID KEY: the row's menu (right-click, or m): click an action, or move to it and press enter
  local id=$2 key=$3 D=$'\e[90m' E=$'\e[31m' R=$'\e[0m' head line act new pick pr=
  local -a acts  # ACTION<tab>label
  local name st att age url model dir title branch changed waitfor
  local repo num ptitle purl draft pbranch review checks updated
  split_key $key
  if [[ $KP == +pr && -n $KS ]]; then
    for line in ${(f)"$(<$STATE/prs)"}; do
      IFS=$'\037' read -r repo num ptitle purl draft pbranch review checks updated <<<"$line"
      [[ $purl == $KS ]] && break
    done
    [[ $purl == $KS ]] || exit 0
    head="#$num $ptitle"
    acts=( $'open\topen in the browser' $'checks\topen its checks' $'files\topen its files' $'copy\tcopy its link' )
    [[ -n $pbranch ]] && acts+=( $'copybranch\tcopy its branch' )
    acts+=( $'session\tnew session on '${repo:t} $'review\task Claude to review it' )
    [[ $checks == (FAILURE|ERROR) ]] && acts+=( $'fix\task Claude to fix the failing checks' $'rerun\tre-run the failed checks' )
    [[ $draft == true ]] && acts+=( $'ready\tmark it ready for review' )
    [[ $checks == SUCCESS && $draft != true && $review != (CHANGES_REQUESTED|REVIEW_REQUIRED) ]] &&
      acts+=( "merge"$'\t'"${E}merge it (squash)…$R" )
    acts+=( "close"$'\t'"${E}close it…$R" )
  elif [[ $KP == +pr ]]; then
    head="pull requests"
    acts=( $'all\topen all your pull requests on GitHub' $'refresh\trefresh the list now' )
  elif [[ -z $KS ]]; then
    [[ -e $PROFILES/$KP.conf ]] || exit 0
    head=$KP
    acts=( $'opus\tnew Opus session here' $'sonnet\tnew Sonnet session here' $'test\ttest this machine' $'reload\trefresh' )
  else
    load $KP || exit 0
    for line in ${(f)"$(<$STATE/raw-$KP)"}; do
      IFS=$'\037' read -r name st att age url model dir title branch changed waitfor <<<"$line"
      [[ $name == $KS ]] && break
    done
    [[ $name == $KS ]] || exit 0
    head=$KS
    acts=( $'view\tview it here' $'focus\tview it and type in it' )
    [[ $(mode $id) == ghostty ]] && acts+=( $'tab\topen it in a new Ghostty tab' )
    [[ -n $url ]] && acts+=( $'rc\topen its Remote Control link' $'copyrc\tcopy its Remote Control link' )
    # Its pull request: one of yours on the same branch, in a repository named like its folder.
    if [[ -n $branch && -s $STATE/prs ]]; then
      for line in "${(@)${(f)"$(<$STATE/prs)"}[2,-1]}"; do
        IFS=$'\037' read -r repo num ptitle purl draft pbranch review checks updated <<<"$line"
        [[ $pbranch == $branch && ${repo:t} == ${dir:t} ]] && { pr=$purl; acts+=( $'pr\topen its pull request #'$num ); break }
      done
    fi
    [[ -n $dir ]] && acts+=( $'github\topen its repository on GitHub' )
    acts+=( $'attach\tcopy the attach command' )
    [[ $P_TYPE == local && -n $dir ]] && acts+=( $'folder\topen its folder' )
    acts+=( $'new\tnew session on this machine' )
    [[ $st == work ]] && acts+=( $'esc\tinterrupt Claude (Esc)' )
    acts+=( $'rename\trename it' "end"$'\t'"${E}end the session…$R" )
  fi
  acts+=( "cancel"$'\t'"${D}cancel$R" )
  _cut $head $(( ${COLUMNS:-56} - 3 ))
  pick=$(print -rl -- $acts | fzf --ansi --layout=reverse --no-input --no-sort --delimiter=$'\t' --with-nth=2 \
    --info=hidden --gutter=' ' --pointer='▌' --highlight-line --color='header:bold,pointer:yellow,current-fg:bold' \
    --header=" $REPLY" --header-border=bottom \
    --bind 'left-click:accept,double-click:accept,right-click:abort,q:abort,esc:abort') || exit 0
  act=${pick%%$'\t'*}
  # gh_do WHAT COMMAND...: runs a GitHub change where you can read its answer; the PR list refreshes after it.
  gh_do() { print -r -- "$1 ..."; shift; "$@" 2>&1; rm -f $STATE/prs; print -n "press a key"; read -k1 -s }
  case $act in
    open)  browse $purl ;;
    checks) browse $purl/checks ;;
    files) browse $purl/files ;;
    copy)  clip $purl ;;
    copybranch) clip $pbranch ;;
    session) $SELF _new opus $id +pr/ ${repo:t} ;;
    review) $SELF _new opus $id +pr/ ${repo:t}-pr$num "Review pull request #$num of $repo ($purl). If this folder \
is not a clone of $repo, clone it first. Check it out with gh pr checkout $num, read the diff and the discussion, \
and report what you find, most severe first." ;;
    fix) $SELF _new opus $id +pr/ ${repo:t}-pr$num "The checks of pull request #$num of $repo ($purl) are failing. \
If this folder is not a clone of $repo, clone it first. Check it out with gh pr checkout $num, find out why with \
gh pr checks $num, fix it and push." ;;
    rerun) gh_do "re-running the failed checks of #$num" gh run rerun \
             "$(gh run list --repo $repo --branch $pbranch --status failure -L 1 --json databaseId -q '.[0].databaseId')" \
             --failed --repo $repo ;;
    ready) gh_do "marking #$num ready for review" gh pr ready $num --repo $repo ;;
    merge) print -rn -- "Merge #$num of $repo (squash)? [y/N] "
           read -q && { print; gh_do "merging #$num" gh pr merge $num --repo $repo --squash } ;;
    close) print -rn -- "Close #$num of $repo without merging? [y/N] "
           read -q && { print; gh_do "closing #$num" gh pr close $num --repo $repo } ;;
    all)   browse https://github.com/pulls ;;
    refresh) rm -f $STATE/prs ;;
    opus|sonnet) $SELF _new $act $id $key ;;
    test)  $SELF profile test $KP; print -n "press a key"; read -k1 -s ;;
    view)  $SELF _select $id $key force ;;
    focus) $SELF _select $id $key force; $SELF _focus $id ;;
    tab)   $SELF _tab $id $key ;;
    rc)    browse $url ;;
    copyrc) clip $url ;;
    pr)    browse $pr ;;
    github)
      line=$(on 'git -C "$1" remote get-url origin 2>/dev/null' $dir)
      line=${${line%.git}/#(git@github.com:|ssh:\/\/git@github.com\/)/https://github.com/}
      [[ $line == https://* ]] && browse $line ;;
    attach)
      if [[ $P_TYPE == local ]]; then clip "tmux attach -t =$KS"
      else clip "ssh ${P_KEY:+-i $P_KEY }${P_PORT:+-p $P_PORT }-t $P_HOST tmux attach -t =$KS"; fi ;;
    folder) browse $dir ;;
    new)   $SELF _new opus $id $key ;;
    esc)   on 'tmux send-keys -t "=$1:" Escape' $KS ;;
    rename)
      read -r "new?Rename $KS to: "
      [[ -z $new || $new == $KS ]] && exit 0
      [[ $new == *[.:/\|]* ]] && { print -r -- 'names cannot contain ".", ":", "/" or "|" — press a key'; read -k1 -s; exit 0 }
      on 'tmux rename-session -t "=$1" "$2"' $KS $new || { print -n "press a key"; read -k1 -s; exit 0 }
      [[ $(<$STATE/$id.target 2>/dev/null) == $key ]] && print -rn -- "$KP/$new" >$STATE/$id.target ;;
    end)   $SELF _kill $key ;;
  esac
  ;;

_attach)  # _attach KEY
  split_key $2; load $KP || exit 1
  on -t "$CLIP"'unset TMUX; exec tmux attach -t "=$1"' $KS
  ;;

_panel)  # _panel ID
  local id=$2 me
  printf '\e]2;lzr1 panel\a'
  if [[ $(mode $id) == tmux ]]; then
    me=$TMUX_PANE
    print -rn -- $me >$STATE/$id.me
  else
    repeat 20; do [[ -s $STATE/$id.me ]] && break; sleep 0.1; done
    me=$(<$STATE/$id.me 2>/dev/null)
    # Narrow this split to PANEL_W columns: move the divider, measure, correct once.
    if [[ -n $me ]] && (( COLUMNS > PANEL_W + 4 )); then
      local c0=$COLUMNS c1
      ghostty "perform action \"resize_split:left,200\" on (terminal id \"$me\")" >/dev/null; sleep 0.25
      c1=$(tput cols)
      (( c0 > c1 && c1 > PANEL_W )) && ghostty "perform action \"resize_split:left,$(( (c1 - PANEL_W) * 200 / (c0 - c1) ))\" on (terminal id \"$me\")" >/dev/null
    fi
  fi
  local S=$SELF
  # A row's menu opens on the right button (LZR1_MENU_BUTTON=left: on the left one, which then also picks the row).
  local menu="execute($S _menu $id {1})+reload-sync($S _list $id)" button=right-click
  [[ $MENU_BUTTON == left ]] && button=left-click
  # The ticker and _pos send reloads through fzf's port, which plain --listen refuses; a per-panel key keeps
  # any other local process from sending commands to it.
  export FZF_API_KEY=$(openssl rand -hex 16)
  fzf --ansi --read0 --no-input --layout=reverse --no-sort --track --id-nth=1 \
    --delimiter=$'\t' --with-nth=2 --header-lines=1 \
    --listen-unsafe --no-scrollbar --info=hidden --pointer='▌' --gutter=' ' --highlight-line \
    --border=none --header-border=bottom --header-label=' lzr1 ' \
    --footer='[+opus] [+sonnet] [↻] [?]' --footer-border=top \
    --color='header:dim,footer:yellow,pointer:yellow,current-fg:bold' \
    --bind "start:reload($S _list $id)+execute-silent($S _ticker $id \$FZF_PORT)" \
    --bind "focus:execute-silent($S _select $id {1} &)" \
    --bind "enter:execute-silent($S _go $id {1})" \
    --bind "double-click:execute-silent($S _go $id {1})" \
    --bind "$button:$menu" --bind "m:$menu" \
    --bind "t:execute-silent($S _tab $id {1})" \
    --bind "o:execute-silent($S _open_url {1})" \
    --bind "n:execute($S _new opus $id {1})+reload-sync($S _list $id)" \
    --bind "s:execute($S _new sonnet $id {1})+reload-sync($S _list $id)" \
    --bind "x:execute($S _kill {1})+reload-sync($S _list $id)" \
    --bind "r:reload-sync($S _list $id)" \
    --bind "?:execute($S keys; read -k1 -s)" \
    --bind "q:abort,esc:abort" \
    --bind "click-footer:transform:case \$FZF_CLICK_FOOTER_WORD in
        *opus*)   echo 'execute($S _new opus $id {1})+reload-sync($S _list $id)' ;;
        *sonnet*) echo 'execute($S _new sonnet $id {1})+reload-sync($S _list $id)' ;;
        *↻*)      echo 'reload-sync($S _list $id)' ;;
        *\?*)     echo 'execute($S keys; read -k1 -s)' ;;
      esac"
  ;;

keys)
  cat <<'EOF'

  lzr1-panel keys

  click / ↑ ↓      show that session in the viewer
  enter / dbl-click  show it and move the keyboard to the viewer (a PR: open it)
  right-click / m  the row's menu: links, copy, Claude on a PR, rename, end...
  n  or [+opus]    new Opus session on the highlighted row's profile
  s  or [+sonnet]  new Sonnet session (a repository name opens in its folder)
  t                open the session in a new Ghostty tab
  o                open its Remote Control link (a PR: the PR) in the browser
  x                end the session (asks first)
  r  or [↻]        refresh now (it refreshes every 15s)
  q                close the panel

  In the viewer: Ctrl-b d leaves a session; Ctrl-C goes to Claude.
  Copy: drag to select, it is copied when you let go; Ctrl-C copies a selection.
  In the panel, hold Shift while dragging, then Cmd-C.
  If Claude exits, its session stays: Enter resumes the conversation.

  glyphs: ▶ working  ⧗ waiting on you  · idle  ● a terminal is attached
  PRs:    ✓ checks passed  ✗ failed or changes requested  ⧗ running or review pending  ◌ draft

  press a key
EOF
  ;;

splash) lzr1_splash ${2:+${2#--}} ;;

version|--version) print -r -- "lzr1-panel $VERSION" ;;

*)
  sed -n '2,15p' $SELF | sed 's/^# \{0,1\}//'
  [[ -z $1 || $1 == (help|-h|--help) ]] || exit 1
  ;;
esac
