#!/usr/bin/env zsh
# lzr1-panel: Claude Code sessions running in tmux on your machines, listed by profile in a clickable panel on the
# left, with a viewer on the right that shows the session you pick.
#
#   lzr1-panel open                                  panel + viewer (Ghostty split on macOS, else a tmux layout)
#   lzr1-panel start PROFILE opus|sonnet|opencode NAME [args]
#                                                    start a detached Claude (or opencode, auto-approve on) session
#                                                    on PROFILE; a NAME that is a folder under the profile's repos
#                                                    opens in it, else in its root
#   lzr1-panel run [--model M] [--effort E] [args]   Claude in a new tmux session in this folder, attached (print
#                                                    mode, -p, runs plain claude); the panel lists it when this
#                                                    folder is inside a profile's repositories folder
#   lzr1-panel run --opencode [args]                 the same with opencode --auto (its subcommands run plain)
#   lzr1-panel attach PROFILE NAME                   this terminal into a session
#   lzr1-panel list                                  print every profile's sessions, then your open PRs
#   lzr1-panel prs                                   your open pull requests (the GitHub account on this machine)
#   lzr1-panel doctor                                check everything the panel needs, with the fix for what is missing
#   lzr1-panel notify                                a sample alert: the tone and a notification, to check them
#   lzr1-panel profile list|show|add|edit|test|remove manage profiles (lzr1-panel profile help)
#   lzr1-panel keys                                  the panel's keys
#   lzr1-panel splash                                the opening animation (LZR1_SPLASH=0 skips it everywhere)
#   lzr1-panel remote on [--allow EMAIL] [--ttl 8h]  the panel in a browser on your tailnet: prints a private URL and
#                                                    password, copies the URL (docs/remote.md); LZR1_REMOTE_TTL (8h),
#                                                    LZR1_REMOTE_IDLE (30m without input logs a browser out),
#                                                    LZR1_REMOTE_NOTIFY=0 (no login or wrong-password alerts)
#   lzr1-panel remote off|status|url|password        end it, show it (with its logins and failures), copy the URL or
#                                                    the password again
#
# Profiles live in ~/.config/lzr1-panel/profiles/<name>.conf, outside the repository: hosts, keys and paths are yours.
emulate -L zsh
setopt pipe_fail extended_glob
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

VERSION=0.1.0
SELF=${0:A}
CONFIG=${LZR1_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/lzr1-panel}
PROFILES=$CONFIG/profiles
STATE=${XDG_CACHE_HOME:-$HOME/.cache}/lzr1-panel
PANEL_W=${LZR1_PANEL_WIDTH:-56}  # the panel's columns
NARROW=${LZR1_NARROW:-$(( PANEL_W + 30 ))}  # a tmux layout under this many columns shows one pane at a time; 0: never
[[ $NARROW == <-> ]] || NARROW=$(( PANEL_W + 30 ))
MENU_BUTTON=${LZR1_MENU_BUTTON:-right}  # the mouse button that opens a row's menu: right or left
mkdir -p $PROFILES $STATE
chmod 700 $CONFIG $PROFILES 2>/dev/null  # profiles hold hosts and key paths

die() { print -ru2 -- "lzr1-panel: $*"; exit 1 }

source ${SELF:h:h}/lib/splash.zsh

# ---- profiles -------------------------------------------------------------------------------------------------------

# A profile is KEY=value lines, read as data (never sourced):
#   type=local|ssh  host=user@host  key=~/.ssh/id  port=22  root=~/work  repos=~/work/repos  claude=/path/to/claude
#   opencode=/path/to/opencode  (optional: without it, opencode from the machine's PATH)
#   only=~/work  (list only the sessions whose folder is inside it, so profiles can share a machine).
#   profile add writes root= and only= equal to repos=; older profiles may differ.
load() {
  local f=$PROFILES/$1.conf k v
  [[ -n $1 && -r $f ]] || { print -ru2 -- "lzr1-panel: no profile '$1' (see: lzr1-panel profile list)"; return 1 }
  P_NAME=$1 P_TYPE= P_HOST= P_KEY= P_PORT= P_ROOT= P_REPOS= P_CLAUDE= P_ONLY= P_OPENCODE=
  while IFS='=' read -r k v; do
    case $k in
      type) P_TYPE=$v ;; host) P_HOST=$v ;; key) P_KEY=${v/#\~/$HOME} ;; port) P_PORT=$v ;;
      root) P_ROOT=$v ;; repos) P_REPOS=$v ;; claude) P_CLAUDE=$v ;; only) P_ONLY=$v ;;
      opencode) P_OPENCODE=$v ;;
    esac
  done <$f
  [[ $P_TYPE == (local|ssh) ]] || { print -ru2 -- "lzr1-panel: profile '$1' needs type=local or type=ssh"; return 1 }
  [[ $P_TYPE == local || -n $P_HOST ]] || { print -ru2 -- "lzr1-panel: profile '$1' needs host="; return 1 }
  : ${P_CLAUDE:=claude} ${P_OPENCODE:=opencode}
  return 0
}

profiles() { local f; for f in $PROFILES/*.conf(N); do print -r -- ${f:t:r}; done }

# on [-t] SCRIPT ARGS...: runs a POSIX sh script on the loaded profile's machine; -t gives it a terminal.
on() {
  local tty=; [[ $1 == -t ]] && { tty=1; shift }
  local script=$1; shift
  if [[ $P_TYPE == local ]]; then
    # Not the tmux this panel may be running in: the machine's own default server.
    env -u TMUX -u TMUX_PANE sh -c "$script" sh "$@"
    return
  fi
  mkdir -p ~/.ssh/cm
  # One shared connection per machine keeps refreshes and switches fast.
  local -a ssh=(ssh -o BatchMode=yes -o ConnectTimeout=5 -o ControlMaster=auto
                -o "ControlPath=$HOME/.ssh/cm/lzr1-%C" -o ControlPersist=10m)
  [[ -n $P_KEY ]] && ssh+=(-i $P_KEY)
  [[ -n $P_PORT ]] && ssh+=(-p $P_PORT)
  if [[ -n $tty ]]; then
    # The machine may not know this terminal's TERM (xterm-ghostty, say); tmux needs one it knows.
    TERM=xterm-256color $ssh -t $P_HOST "sh -c ${(qq)script} sh ${(j: :)${(qq)@}}"
  else
    $ssh $P_HOST "sh -c ${(qq)script} sh ${(j: :)${(qq)@}}"
  fi
}

# Shared by the scripts below: expands a leading ~ on the machine that runs them.
EXP='exp() { case $1 in "~"|"~/"*) printf "%s" "$HOME${1#"~"}" ;; *) printf "%s" "$1" ;; esac; }
'

# Run before attaching a viewer, on the machine: with tmux's mouse on, a drag selects in tmux, out of the terminal's
# reach, and the selection used to vanish on release with Cmd+C left nothing to copy. Now releasing the mouse copies
# the selection and keeps it shown, Ctrl+C copies it and leaves copy mode, and the copy reaches this computer's
# clipboard: through pbcopy on a Mac, and through the terminal (OSC 52) from any machine, SSH included.
# Claude Code takes the mouse itself and copies its own selection with OSC 52, which some terminals (macOS
# Terminal) ignore: on a Mac, tmux hands those copies to pbcopy too.
CLIP='tmux set -s set-clipboard on 2>/dev/null
tmux set -s "terminal-features[90]" "*:clipboard" 2>/dev/null
c=; command -v pbcopy >/dev/null 2>&1 && c=pbcopy
[ -n "$c" ] && tmux set-hook -g pane-set-clipboard "run-shell -b \"tmux save-buffer - | $c\"" 2>/dev/null
for t in copy-mode copy-mode-vi; do
  tmux bind -T $t MouseDragEnd1Pane send -X copy-pipe-no-clear $c 2>/dev/null
  tmux bind -T $t C-c send -X copy-pipe-and-cancel $c 2>/dev/null
done
'

# One record per session back to the panel, fields split by \037 (empty fields survive it, unlike a tab):
# name state attached idle-seconds rc-link model folder task branch changed-files waiting-for
# $1, when set, is the profile's only= folder: sessions elsewhere are left out.
LIST_SCRIPT='
  now=$(date +%s) us=$(printf "\037") host=$(hostname) only=$(exp "$1"); only=${only%/}
  # tmux escapes control characters in -F output, so its fields split on "|"; the task title comes last, where a "|"
  # inside it stays put. Session names cannot contain "|" (lzr1-panel refuses them).
  tmux list-sessions -F "#{session_name}|#{session_attached}|#{session_activity}|#{@rc_url}|#{@lzr1_model}|#{pane_current_path}|#{@lzr1_agent}|#{pane_title}" 2>/dev/null |
  while IFS="|" read -r name att act url model dir agent title; do
    if [ -n "$only" ]; then case $dir in "$only"|"$only"/*) ;; *) continue ;; esac; fi
    full=$(tmux capture-pane -p -J -t "=$name:" 2>/dev/null)
    screen=$(printf "%s\n" "$full" | tail -25)
    if [ "$agent" = opencode ]; then
      # opencode shows "esc interrupt" in its bottom bar while it works ("esc again to interrupt" after one Esc),
      # and its question dialog ends in "enter submit". It titles the terminal "OC | <session title>", or
      # "OpenCode" before it has one.
      if printf "%s" "$screen" | grep -qE "esc (again to )?interrupt"; then st=work
      elif printf "%s" "$screen" | grep -qE "enter submit|Permission required|opencode exited"; then st=wait
      else st=idle; fi
      title=${title#"OC | "}; [ "$title" = OpenCode ] && title=
    else
      if printf "%s" "$screen" | grep -q "esc to interrupt"; then st=work
      elif printf "%s" "$screen" | grep -qE "Enter to select|Do you want to|Would you like to proceed|Claude exited"; then st=wait
      else st=idle; fi
      # The newest link on screen wins: a resumed conversation gets a new one.
      new=$(printf "%s" "$full" | grep -o "https://claude.ai/code/session_[A-Za-z0-9]*" | tail -1)
      if [ -n "$new" ] && [ "$new" != "$url" ]; then url=$new; tmux set-option -t "=$name:" @rc_url "$url"; fi
      # Sessions lzr1-panel started carry their model; others show it in Claude Code'"'"'s header.
      [ -n "$model" ] || model=$(printf "%s\n" "$full" | head -8 | grep -oE "Opus|Sonnet|Haiku|Fable" | head -1 | tr "A-Z" "a-z")
      # Claude titles the terminal with its current task, after a spinner glyph.
      title=$(printf "%s" "$title" | sed "s/^[^[:alnum:]]*//")
      case $title in "$host"|"$host".*|"Claude Code"|"") title= ;; esac
    fi
    branch= changed=
    if [ -n "$dir" ] && b=$(git -C "$dir" branch --show-current 2>/dev/null); then
      branch=${b:-detached}; changed=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d " ")
    fi
    waitfor=
    if [ $st = wait ]; then
      # The exit of this session'"'"'s own agent only: Claude may well show "opencode exited" in its work.
      ex=Claude; [ "$agent" = opencode ] && ex=opencode
      ex=$(printf "%s" "$screen" | grep -o "$ex exited" | tail -1)
      if [ -n "$ex" ]; then waitfor="$ex · Enter resumes"
      elif [ "$agent" = opencode ]; then
        # The question is the dialog'"'"'s last non-empty line above its first option, inside a "┃" border.
        if printf "%s" "$screen" | grep -q "┃[[:space:]]*1\. "; then
          waitfor=$(printf "%s\n" "$screen" | sed -n "/┃[[:space:]]*1\. /q; p" | sed "s/┃//g; s/^[[:space:]]*//; s/[[:space:]]*$//" | grep . | tail -1)
        fi
        [ -n "$waitfor" ] || waitfor="waiting on you"
      else
        waitfor=$(printf "%s\n" "$screen" | grep -E "Do you want|Would you like|\?[[:space:]│]*$" | tail -1 | sed "s/^[[:space:]│╭╰|]*//; s/[[:space:]│╮╯|]*$//")
        [ -n "$waitfor" ] || waitfor="waiting on you"
      fi
    fi
    printf "%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s$us%s\n" "$name" "$st" "$att" "$((now - act))" "$url" "$model" "$dir" "$title" "$branch" "$changed" "$waitfor"
  done'

# ---- profile management ---------------------------------------------------------------------------------------------

profile_help() {
  cat <<'EOF'
lzr1-panel profile list
lzr1-panel profile show NAME
lzr1-panel profile add                                   guided: asks for everything
lzr1-panel profile add NAME --local --repos PATH [--claude PATH] [--opencode PATH]
lzr1-panel profile add NAME --ssh USER@HOST --repos PATH [--key FILE] [--port N] [--claude PATH] [--opencode PATH]
lzr1-panel profile edit NAME                             the same questions, each showing its current value
lzr1-panel profile test NAME                             reach it, find tmux, claude and opencode, check the folders
lzr1-panel profile remove NAME

NAME: lowercase letters, digits and dashes (oracle-server, macbook-pro-lazari); a _ becomes a dash.
--repos: the folder holding your repositories. A profile opens and lists only the sessions inside --repos, so two
         profiles can share one machine, one folder each, without listing the same sessions twice.
--opencode: optional; without it, add looks for opencode there and the profile works without it.
Paths may start with ~, read on the profile's machine.
EOF
}

profile_test() {
  load $1 || return 1
  print -r -- "profile $1 ($P_TYPE${P_HOST:+ $P_HOST})${P_ONLY:+, only sessions in $P_ONLY}"
  local out
  out=$(on "$EXP"'
    printf "reach=ok\n"
    printf "tmux=%s\n" "$(command -v tmux || echo missing)"
    c=$(exp "$1"); case $c in */*) [ -x "$c" ] || c=missing ;; *) c=$(command -v "$c" || echo missing) ;; esac
    printf "claude=%s\n" "$c"
    c=$(exp "$4"); case $c in */*) [ -x "$c" ] || c= ;; *) c=$(command -v "$c") ;; esac
    printf "opencode=%s\n" "${c:-not installed (opencode sessions unavailable)}"
    r=$(exp "$2"); [ -d "$r" ] && printf "repos=%s (%s folders)\n" "$r" "$(ls -1 "$r" | wc -l | tr -d " ")" || printf "repos=%s missing\n" "$r"
    o=$(exp "$3"); [ -d "$o" ] && printf "root=%s\n" "$o" || printf "root=%s missing\n" "$o"
  ' "$P_CLAUDE" "${P_REPOS:-~}" "${P_ROOT:-${P_REPOS:-~}}" "$P_OPENCODE" 2>&1) || { print -r -- "  cannot reach it: $out"; return 1 }
  local bad=0 line
  for line in ${(f)out}; do
    print -r -- "  ${line/=/: }"
    [[ $line == *missing* ]] && bad=1
  done
  (( bad )) && print -r -- "  fix the missing items above (tmux and Claude Code must be installed there)"
  return $bad
}

# $1, a profile name asked for: REPLY is the name to use (a _ becomes -), or WHY says what is wrong with it.
profile_name() {
  REPLY=${1//_/-} WHY=
  [[ $REPLY == $1 ]] || print -r -- "  using $REPLY"
  if [[ $REPLY != [a-z0-9][a-z0-9-]# ]]; then WHY="profile name: lowercase letters, digits and dashes"
  elif [[ -e $PROFILES/$REPLY.conf ]]; then WHY="profile '$REPLY' exists (lzr1-panel profile remove $REPLY first)"
  fi
  [[ -z $WHY ]]
}

profile_add() {
  local name type host key port repos claude opencode REPLY WHY
  # One guided answer: the prompt shows even when the answers are piped in; the end of input stops the questions.
  ask() { print -rnu2 -- "$2"; IFS= read -r $1 || { print -u2; die "profile add: no answer" } }
  if (( $# == 0 )); then
    # Guided: the same questions an agent asks, then the same command.
    print "New lzr1-panel profile (Claude Code sessions only, for now)"
    while :; do
      ask name "  Profile name (e.g. macbook-pro-lazari): "
      profile_name "$name" && break
      print -r -- "  $WHY"
    done
    name=$REPLY
    print "  Target: 1) this computer   2) another machine over SSH"
    ask type "  Choose 1 or 2: "
    if [[ $type == 2 ]]; then
      type=ssh
      ask host "  SSH user@host: "
      ask key "  SSH key file (empty: your SSH defaults): "
      ask port "  SSH port (empty: 22): "
    else
      type=local
    fi
    while [[ -z $repos ]]; do ask repos "  Folder with your repositories (e.g. ~/Github/my-repositories): "; done
  else
    name=$1; shift
    while (( $# )); do
      case $1 in
        --local) type=local ;;
        --ssh) type=ssh host=$2; shift ;;
        --key) key=$2; shift ;;
        --port) port=$2; shift ;;
        --repos) repos=$2; shift ;;
        --claude) claude=$2; shift ;;
        --opencode) opencode=$2; shift ;;
        --root|--only) die "profile add: --root and --only are gone: a profile opens and lists sessions inside --repos" ;;
        *) die "profile add: unknown option $1" ;;
      esac
      shift
    done
    profile_name "$name" || die "$WHY"
    name=$REPLY
  fi
  [[ $type == (local|ssh) ]] || die "profile add: choose --local or --ssh USER@HOST"
  [[ $type == local || -n $host ]] || die "profile add: --ssh needs USER@HOST"
  [[ -n $repos ]] || die "profile add: --repos PATH is required"
  [[ $key == \~* ]] && key=$HOME${key#\~}
  [[ -z $key || -r $key ]] || die "SSH key not readable: $key"
  # Store paths to claude and opencode that work without a login shell: tmux starts them with a bare PATH.
  P_TYPE=$type P_HOST=$host P_KEY=$key P_PORT=$port
  if [[ -z $claude ]]; then
    claude=$(on 'command -v claude 2>/dev/null || { [ -x "$HOME/.local/bin/claude" ] && echo "$HOME/.local/bin/claude"; }' 2>/dev/null)
    [[ -n $claude ]] || die "Claude Code not found on that machine (install it there, or pass --claude PATH)"
  fi
  # opencode is optional: a machine without it still gets a profile, with no opencode= line.
  [[ -n $opencode ]] || opencode=$(on 'command -v opencode 2>/dev/null || { [ -x "$HOME/.opencode/bin/opencode" ] && echo "$HOME/.opencode/bin/opencode"; }' 2>/dev/null)
  {
    print -r -- "# lzr1-panel profile: $name (written $(date +%Y-%m-%d)). Keep it out of git."
    print -r -- "type=$type"
    [[ -n $host ]] && print -r -- "host=$host"
    [[ -n $key ]] && print -r -- "key=$key"
    [[ -n $port ]] && print -r -- "port=$port"
    print -r -- "repos=$repos"
    print -r -- "root=$repos"
    print -r -- "only=$repos"
    print -r -- "claude=$claude"
    [[ -n $opencode ]] && print -r -- "opencode=$opencode"
  } >$PROFILES/$name.conf
  chmod 600 $PROFILES/$name.conf
  print -r -- "saved $PROFILES/$name.conf"
  profile_test $name
}

# profile_edit NAME: asks name, (ssh) host, key and port, then the repositories folder, each prefilled (vared; Enter
# keeps it). Piped answers: an empty line keeps the value, - empties it. root= and only= become the repositories
# folder, as for a new profile (said when that narrows what it listed); claude= and any other line stay; a missing
# opencode= is looked up as add does. A new name writes the new file, then removes the old and moves the panel's
# state (targets, raw-, seen/, unread/) to it.
profile_edit() {
  local old=$1 name host key port repos line oc was t c REPLY WHY f=$PROFILES/$1.conf
  load $old || exit 1
  name=$old host=$P_HOST key=$P_KEY port=$P_PORT repos=$P_REPOS
  # zsh picks vi keys when $EDITOR says vi, and vi's insert mode cannot delete a prefilled value: bind these keys so it can.
  [[ -t 0 ]] && bindkey -M viins '^?' backward-delete-char '^H' backward-delete-char '^U' kill-whole-line \
    '^W' backward-kill-word 2>/dev/null
  keep() {
    if [[ -t 0 ]]; then vared -p "$2" $1 || die "profile edit: no answer"; return; fi
    local a; print -rnu2 -- "$2[${(P)1}] "; IFS= read -r a || { print -u2; die "profile edit: no answer" }
    case $a in -) : ${(P)1::=} ;; ?*) : ${(P)1::=$a} ;; esac
  }
  print -r -- "Edit profile $old (Enter keeps a value)"
  while :; do
    keep name "  Profile name: "
    profile_name "$name" || [[ $REPLY == $old && -z ${WHY:#*exists*} ]] && break
    print -r -- "  $WHY"; name=$old
  done
  name=$REPLY
  if [[ $P_TYPE == ssh ]]; then
    while keep host "  SSH user@host: "; [[ -z $host ]]; do :; done
    while keep key "  SSH key file (empty: your SSH defaults): "; [[ $key == \~* ]] && key=$HOME${key#\~}
      [[ -n $key && ! -r $key ]]; do print -r -- "  SSH key not readable: $key"; done
    keep port "  SSH port (empty: 22): "
  fi
  while keep repos "  Folder with your repositories: "; [[ -z $repos ]]; do :; done
  if [[ -z ${(M)${(f)"$(<$f)"}:#opencode=*} ]]; then
    P_HOST=$host P_KEY=$key P_PORT=$port
    oc=$(on 'command -v opencode 2>/dev/null || { [ -x "$HOME/.opencode/bin/opencode" ] && echo "$HOME/.opencode/bin/opencode"; }' 2>/dev/null)
  fi
  t=$PROFILES/$name.conf.new
  if ! { {
    print -r -- "# lzr1-panel profile: $name (edited $(date +%Y-%m-%d)). Keep it out of git."
    print -r -- "type=$P_TYPE"
    [[ $P_TYPE == ssh ]] && { print -r -- "host=$host"; [[ -n $key ]] && print -r -- "key=$key"
                              [[ -n $port ]] && print -r -- "port=$port" }
    print -r -- "repos=$repos"
    print -r -- "root=$repos"
    print -r -- "only=$repos"
    for line in ${(f)"$(<$f)"}; do [[ $line == (\#*|(type|host|key|port|repos|root|only)=*) ]] || print -r -- $line; done
    [[ -z $oc ]] || print -r -- "opencode=$oc"
  } >$t } 2>/dev/null || ! chmod 600 $t || ! mv $t $PROFILES/$name.conf; then
    rm -f $t 2>/dev/null; die "profile edit: cannot write $PROFILES/$name.conf"
  fi
  if [[ $name != $old ]]; then
    rm -f $f
    # The panel follows the new name: a viewer on OLD/session moves to NEW/session, unread marks are kept.
    if [[ -d $STATE ]]; then
      _seen_lock
      for c in seen unread; do
        [[ -d $STATE/$c/$old ]] && { rm -rf $STATE/$c/$name; mv $STATE/$c/$old $STATE/$c/$name }
      done
      [[ -e $STATE/raw-$old ]] && mv -f $STATE/raw-$old $STATE/raw-$name
      rm -f $STATE/down-$old
      for c in $STATE/*.target(N) $STATE/*.target.detached(N); do
        line=$(<$c) 2>/dev/null
        [[ $line == $old/* ]] && print -rn -- "$name/${line#$old/}" >$c
      done
      _seen_unlock
    fi
  fi
  print -r -- "saved $PROFILES/$name.conf"
  if [[ -z $P_ONLY ]]; then was="every session on the machine"
  elif [[ $P_ONLY != $repos ]]; then was="sessions inside $P_ONLY"
  fi
  [[ -n $P_ROOT && $P_ROOT != $repos && $P_ROOT != $P_ONLY ]] && was+="${was:+, }new ones opening in $P_ROOT"
  [[ -n $was ]] && print -r -- "  now lists and opens only sessions inside $repos (was: $was)"
  profile_test $name
}

# ---- pull requests --------------------------------------------------------------------------------------------------

# The open pull requests of the GitHub account on this machine, newest first: the account gh is signed in to, or,
# without gh, the one this machine's SSH key belongs to (public PRs only, and it needs jq). The first line is
# LOGIN<us>SOURCE; then one record per PR, fields split by \037:
# repository number title url draft branch review-decision checks updated
prs_fetch() {
  local login
  if command -v gh >/dev/null && gh api graphql -f query='{ viewer { login }
      search(query: "is:pr is:open author:@me sort:updated-desc", type: ISSUE, first: 20) { nodes { ... on PullRequest {
        number title url isDraft updatedAt headRefName reviewDecision repository { nameWithOwner }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } } } }' --jq '
      "\(.data.viewer.login)\u001fgh",
      (.data.search.nodes[] | [.repository.nameWithOwner, (.number | tostring), .title, .url, (.isDraft | tostring),
        .headRefName, (.reviewDecision // ""), (.commits.nodes[0].commit.statusCheckRollup.state // ""), .updatedAt]
        | join("\u001f"))' 2>/dev/null; then
    return 0
  fi
  # GitHub greets an SSH key with its account: "Hi LOGIN! You've successfully authenticated, ..."
  login=$(ssh -T -o BatchMode=yes -o ConnectTimeout=5 git@github.com 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p')
  [[ -n $login ]] && command -v jq >/dev/null || return 1
  print -r -- "$login"$'\037'ssh
  curl -sf -m 10 "https://api.github.com/search/issues?q=is:pr+is:open+author:$login&sort=updated&per_page=20" |
    jq -r '.items[] | [(.repository_url | sub(".*/repos/"; "")), (.number | tostring), .title, .html_url,
      (.draft | tostring), "", "", "", .updated_at] | join("\u001f")'
}

# The cached list, refreshed at most once a minute (the search takes about a second); LZR1_PRS=0 turns it off.
# A failed search keeps the last list and waits a minute too.
prs_refresh() {
  [[ ${LZR1_PRS:-1} == 0 ]] && return
  local -a fresh=( $STATE/prs(Nms-60) )
  (( $#fresh )) && return
  prs_fetch >$STATE/prs.$$ || { rm -f $STATE/prs.$$; touch $STATE/prs; return }
  # gh failing for a moment must not swap its full list for the SSH key's public PRs: keep the last gh list.
  if [[ $(head -1 $STATE/prs.$$) == *$'\037'ssh && $(head -1 $STATE/prs 2>/dev/null) == *$'\037'gh ]]; then
    rm -f $STATE/prs.$$; touch $STATE/prs; return
  fi
  mv $STATE/prs.$$ $STATE/prs
}

# _ago SECONDS: 45s, 12m, 3h or 2d, into REPLY
_ago() {
  if   (( $1 < 60 ));    then REPLY=${1}s
  elif (( $1 < 3600 ));  then REPLY=$(( $1 / 60 ))m
  elif (( $1 < 86400 )); then REPLY=$(( $1 / 3600 ))h
  else REPLY=$(( $1 / 86400 ))d; fi
}

# A PR row's key is +pr/URL; the section heading's is +pr/.
pr_rows() {  # pr_rows WIDTH: the PR section's fzf items, after the sessions (layout 1, cards)
  [[ ${LZR1_PRS:-1} == 0 || ! -s $STATE/prs ]] && return
  local W=$1 D=$'\e[90m' B=$'\e[1m' Y=$'\e[33m' G=$'\e[32m' E=$'\e[31m' M=$'\e[37m' R=$'\e[0m'
  local -a got=( ${(f)"$(<$STATE/prs)"} )
  local login src repo num title url draft branch review checks updated glyph words color hd fl t age pre l1 l2 line
  IFS=$'\037' read -r login src <<<"${got[1]}"
  zmodload zsh/datetime; local TZ=UTC  # GitHub's times are UTC
  hd=" pull requests $login · $src · $(( $#got - 1 )) "
  fl=$(( W - ${#hd} - 1 )); (( fl < 0 )) && fl=0
  # The heading starts with five blank lines: a gap between the sessions and the PRs that the cursor never lands on.
  print -rn -- "+pr/"$'\t\n\n\n\n\n'" ${B}pull requests$R $D$login · $src · $(( $#got - 1 )) ${(l:fl::─:)}$R"$'\0'
  for line in "${(@)got[2,-1]}"; do
    IFS=$'\037' read -r repo num title url draft branch review checks updated <<<"$line"
    # One glyph from the draft flag, the latest commit's checks and the review, worst first.
    if [[ $draft == true ]]; then glyph="$D◌$R" words=draft color=$D
    elif [[ $checks == (FAILURE|ERROR) ]]; then glyph="$E✗$R" words="checks failed" color=$E
    elif [[ $review == CHANGES_REQUESTED ]]; then glyph="$E✗$R" words="changes requested" color=$E
    elif [[ $checks == (PENDING|EXPECTED) ]]; then glyph="$Y⧗$R" words="checks running" color=$Y
    elif [[ $review == REVIEW_REQUIRED ]]; then glyph="$Y⧗$R" words="review required" color=$Y
    elif [[ $checks == SUCCESS ]]; then glyph="$G✓$R" color=$G words="checks passed${${(M)review:#APPROVED}:+ · approved}"
    else glyph="$D·$R" words=${${review:l}//_/ } color=$D; fi
    t=$EPOCHSECONDS; [[ -n $updated ]] && strftime -r -s t '%Y-%m-%dT%H:%M:%SZ' $updated 2>/dev/null
    _ago $(( EPOCHSECONDS - t )); age=$REPLY
    _cut "#$num $title" $(( W - 6 - ${#age} )); l1=" $glyph $M${(r:W - 6 - ${#age}:)REPLY}$R $D$age$R"
    pre="${repo:t}${branch:+ · ⎇ $branch}${words:+ · }"
    _cut "$pre$words" $(( W - 4 ))
    if (( ${#REPLY} > ${#pre} )); then l2="   $D$pre$R$color${REPLY:${#pre}}$R"; else l2="   $D$REPLY$R"; fi
    print -rn -- "+pr/$url"$'\t'"$l1"$'\n'"$l2"$'\0'
  done
}

# ---- panel internals ------------------------------------------------------------------------------------------------

# A row key is PROFILE/SESSION; a profile's heading row is PROFILE/.
split_key() { KP=${1%%/*} KS=${1#*/} }

# The script goes in on stdin, not the command line, where any process could read the variables genv passes.
ghostty() { print -r -- "tell application \"Ghostty\""$'\n'"$1"$'\n'"end tell" | osascript - }

# genv: AppleScript that hands a new Ghostty surface (into cfg) the variables a bare login shell lacks: Ghostty
# starts a split's command without your shell's startup files, so a token set there (gh's GITHUB_TOKEN, say)
# would be missing and the pull requests would fall back to your SSH key's public ones.
genv() {
  local v; local -a kv
  for v in GITHUB_TOKEN GH_TOKEN GH_HOST LZR1_CONFIG LZR1_PRS LZR1_MENU_BUTTON LZR1_PANEL_WIDTH LZR1_NOTIFY LZR1_SOUND; do
    [[ -n ${(P)v} ]] && kv+=( "\"$v=${${(P)v}//(#m)[\\\"]/\\$MATCH}\"" )
  done
  (( $#kv )) && print -r -- "set environment variables of cfg to {${(j:, :)kv}}"
}

mode() { print -rn -- "$(<$STATE/$1.mode)" } 2>/dev/null

browse() { if [[ $OSTYPE == darwin* ]]; then open $1; else xdg-open $1 >/dev/null 2>&1; fi }

# clip TEXT: onto the clipboard of the computer in front of you (pbcopy, wl-copy, xclip, or the terminal's OSC 52)
clip() {
  if command -v pbcopy >/dev/null; then print -rn -- $1 | pbcopy
  elif [[ -n $WAYLAND_DISPLAY ]] && command -v wl-copy >/dev/null; then print -rn -- $1 | wl-copy
  elif [[ -n $DISPLAY ]] && command -v xclip >/dev/null; then print -rn -- $1 | xclip -selection clipboard
  else printf '\e]52;c;%s\a' "$(print -rn -- $1 | base64 | tr -d '\n')" >/dev/tty; fi
}

# _cut TEXT WIDTH: TEXT cut to WIDTH characters with an ellipsis, into REPLY
_cut() { if (( ${#1} > $2 )); then REPLY="${1[1,$2-1]}…"; else REPLY=$1; fi }

# notify_alerts RECORD...: list_rows' alerts ("kind<US>profile<US>session<US>text") on the computer running the
# panel: one tone however many there are (LZR1_SOUND: 0 off, or a sound file), a notification each, up to 3
# (LZR1_NOTIFY=0 off). The text comes from a session's screen: it reaches the notifier as an argument only, never
# inside a script or a command line.
notify_alerts() {
  local r kind p s text verb
  local -a recs more
  _tone
  if [[ $reply[1] == bell ]]; then { print -n '\a' >/dev/tty } 2>/dev/null
  elif (( $#reply )); then $reply >/dev/null 2>&1 &!; fi
  [[ ${LZR1_NOTIFY:-1} == 0 ]] && return 0
  recs=( "$@" ); (( $# > 3 )) && recs=( "${(@)recs[1,2]}" )
  for r in "$@"; do
    IFS=$'\037' read -r kind p s text <<<"$r"
    if (( ${recs[(Ie)$r]} )); then
      verb=asks; [[ $kind == done ]] && verb=finished
      text=${text//[[:cntrl:]]/}; _cut "${text:-your turn}" 120
      _notify_one "$s $verb" $p $REPLY lzr1-$p-$s
    else more+=( $p/$s ); fi
  done
  if (( $#more )); then _cut "${(j:, :)more}" 120; _notify_one "$#more more sessions need you" lzr1-panel $REPLY lzr1-more; fi
}

# _tone: what plays the alert tone here (LZR1_SOUND), as a command into reply: "bell" for the terminal bell, empty
# for none. notify_alerts plays it; doctor reports it.
_tone() {
  local snd=${LZR1_SOUND:-1}; reply=()
  if [[ $snd == 0 ]]; then :
  elif [[ $OSTYPE == darwin* ]]; then
    [[ $snd == 1 ]] && snd=/System/Library/Sounds/Glass.aiff
    [[ -r $snd ]] && reply=( afplay $snd )
  else
    [[ $snd == 1 ]] && snd=/usr/share/sounds/freedesktop/stereo/complete.oga
    if [[ -r $snd ]] && (( $+commands[paplay] )); then reply=( paplay $snd )
    elif [[ ${LZR1_SOUND:-1} == 1 ]] && (( $+commands[canberra-gtk-play] )); then reply=( canberra-gtk-play -i complete )
    elif [[ -r $snd ]] && (( $+commands[canberra-gtk-play] )); then reply=( canberra-gtk-play -f $snd )
    elif [[ ${LZR1_SOUND:-1} == 1 ]]; then reply=( bell ); fi
  fi
}

# _notify_one TITLE SUBTITLE BODY GROUP: one OS notification, silently none where there is no notifier
_notify_one() {
  if [[ $OSTYPE == darwin* ]]; then
    if command -v terminal-notifier >/dev/null; then
      local -a a=( "${@[1,3]}" ); a=( "${(@)a/#-/ -}" )  # a leading - would read as one of its options
      terminal-notifier -title $a[1] -subtitle $a[2] -message $a[3] -group $4 >/dev/null 2>&1
    else
      print -r -- $'on run argv\ndisplay notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)\nend run' |
        osascript - $1 $2 $3 >/dev/null 2>&1
    fi
  elif [[ -n $DISPLAY$WAYLAND_DISPLAY ]] && command -v notify-send >/dev/null; then
    local -a a=( "${@[1,3]}" ); a=( "${(@)${(@)${(@)a//&/&amp;}//\</&lt;}//\>/&gt;}" )  # most daemons read markup
    notify-send -a lzr1-panel -- $a[1] $a[3] >/dev/null 2>&1
  fi
  return 0
}

# _seen_lock: $STATE/seen.lock for this refresh (its pid file holds $$), waited for up to 2s. A lock whose refresh is
# gone (dead pid, older than 10s, or no pid after 1s) is renamed before it is removed, so one panel alone breaks it;
# one taken again meanwhile goes back.
_seen_lock() {
  local l=$STATE/seen.lock t=0 pid; local -a old
  until mkdir $l 2>/dev/null; do
    (( ++t > 20 )) && return 1
    { pid=$(<$l/pid) } 2>/dev/null; old=( $l(N/ms+10) )
    [[ -z $pid ]] && old+=( $l(N/ms+1) )
    if (( $#old )) || { [[ -n $pid ]] && ! kill -0 $pid 2>/dev/null }; then
      if mv $l $l.$$ 2>/dev/null; then
        if { [[ $(<$l.$$/pid) != $pid && ! -e $l ]] } 2>/dev/null; then mv $l.$$ $l; else rm -rf $l.$$; fi
      fi
    else sleep 0.1; fi
  done
  print -r -- $$ >$l/pid
}
_seen_unlock() { { [[ $(<$STATE/seen.lock/pid) == $$ ]] } 2>/dev/null || return 0; rm -rf $STATE/seen.lock }

# _fname NAME: NAME as one file name, into REPLY (% is %25, / is %2F: a session made with plain tmux may hold one)
_fname() { REPLY=${${1//\%/%25}//\//%2F} }

# Every profile's sessions, listed in parallel, as NUL-separated fzf items: "KEY<tab>display". The first item is
# the summary heading. A session is three lines (layout A): name with model and age; its task, or what it waits
# for; its branch and repository. Sized to the panel ($FZF_COLUMNS).
# With a panel ID (list_rows ID, from _list), a session that changes into "needs you" makes an alert: it finished
# its reply (working → idle) or shows a new question. Each session's last state is kept in $STATE/seen/PROFILE/NAME
# ("ts<US>state<US>waitfor", ts the refresh's start), shared by every open panel, so one change alerts once. An alert
# marks the session unread ($STATE/unread/PROFILE/NAME holds its kind) and goes to notify_alerts as
# "kind<US>profile<US>session<US>text". NAME is _fname's (a / in it is %2F).
# An unread session shows ✱ after its glyph, and the summary counts them; the one in the viewer is read already.
list_rows() {
  local -a names=( $(profiles) )
  if (( ! $#names )); then
    print -rn -- $'\t'"no profiles yet"$'\0'
    print -rn -- $'-/\t'$'\e[90m'"run: lzr1-panel profile add"$'\e[0m\0'
    return
  fi
  zmodload zsh/datetime
  local tmp=$(mktemp -d) p snap=$EPOCHREALTIME  # what this refresh saw is as old as its start (_pos's are 0.8s apart)
  local -a down
  for p in $names; do
    # An offline machine is retried once a minute, so it never slows every refresh.
    down=( $STATE/down-$p(Nms-60) )
    if (( $#down )); then : >$tmp/$p.fail; continue; fi
    ( if load $p && on "$EXP$LIST_SCRIPT" "$P_ONLY" >$tmp/$p.out 2>/dev/null; then rm -f $STATE/down-$p
      else : >$tmp/$p.fail; : >$STATE/down-$p; fi ) &
  done
  prs_refresh &
  wait
  local W=$(( ${FZF_COLUMNS:-${COLUMNS:-56}} - 2 )); (( W < 40 )) && W=40
  local -a items got; local n=0 w=0 q=0 i=0 a=0 line kind glyph right l1 l2 l3 mk u pw cur
  local name st att age url model dir title branch changed waitfor
  local D=$'\e[90m' B=$'\e[1m' C=$'\e[36m' Y=$'\e[33m' G=$'\e[32m' M=$'\e[37m' R=$'\e[0m'
  local US=$'\037' track= seeded= f fn pts pst pwf ak
  local -a alerts fresh live sf sv uf uv
  if [[ -n $1 ]]; then
    # One refresh at a time compares and writes; one that cannot get the lock in 2s skips tracking this time (the
    # next refresh catches up).
    if _seen_lock; then
      track=1; setopt local_options local_traps
      trap '_seen_unlock; exit 143' TERM HUP INT; TRAPEXIT() { _seen_unlock }
    fi
    # A panel's first refresh only records, and only what no other panel keeps (a file written in the last
    # minute), so it neither alerts for everything since it was last open nor eats a change another panel is due.
    [[ -e $STATE/$1.seeded ]] && seeded=1
    [[ -r $STATE/$1.target ]] && cur=$(<$STATE/$1.target)
  fi
  for p in $names; do
    # A profile whose machine does not answer is left out until it does.
    [[ -e $tmp/$p.fail ]] && continue
    load $p 2>/dev/null; kind=$P_TYPE
    got=( ${(f)"$(<$tmp/$p.out)"} )
    cp $tmp/$p.out $STATE/raw-$p  # the menu reads a session's details from here
    local hd=" $p $kind · online · $#got " fl
    fl=$(( W - ${#hd} - 1 )); (( fl < 0 )) && fl=0
    items+=( "$p/"$'\t'" $B$p$R $D$kind · online · $#got ${(l:fl::─:)}$R" )
    for line in $got; do
      IFS=$'\037' read -r name st att age url model dir title branch changed waitfor <<<"$line"
      (( n++ ))
      _fname $name; fn=$REPLY ak=
      if [[ -n $track ]]; then
        f=$STATE/seen/$p/$fn pts=0 pst= pwf=
        [[ -r $f ]] && IFS=$US read -r pts pst pwf <$f
        [[ $pts == <->(.<->|) ]] || { pwf=$pst pst=$pts pts=0 }  # an older "state<US>waitfor" file
        # A refresh that started before the one that wrote the file has nothing newer to say.
        if (( pts <= snap )); then
          if [[ -r $f ]]; then
            if [[ $st == wait && $waitfor != *' exited · Enter resumes' && ( $pst != wait || $pwf != "$waitfor" ) ]]
            then ak=question
            elif [[ $pst == work && $st == idle ]]; then ak=done; fi
          fi
          fresh=( $f(Nms-60) )
          [[ -n $seeded ]] || (( ! $#fresh )) && sf+=( $f ) sv+=( "$snap$US$st$US$waitfor" )
          if [[ -n $ak && -n $seeded ]]; then
            alerts+=( "$ak$US$p$US$name$US${${(M)ak:#question}:+$waitfor}${${(M)ak:#done}:+$title}" )
            [[ $p/$name == "$cur" ]] || uf+=( $STATE/unread/$p/$fn ) uv+=( $ak )
          else ak=; fi
        fi
      fi
      case $st in
        work) (( w++ )); glyph="$C▶$R" ;;
        wait) (( q++ )); glyph="$Y⧗$R" ;;
        *)    (( i++ )); glyph="$D·$R" ;;
      esac
      mk= u=$STATE/unread/$p/$fn
      if [[ -n $1 && $p/$name == "$cur" ]]; then rm -f $u
      elif [[ -n $1 && ( -e $u || -n $ak ) ]]; then mk="$B$Y✱$R "; (( a++ )); fi
      _ago $age; age=$REPLY
      right="${model:+$model · }$age"
      pw=$(( W - 6 - ${#right} )); [[ -n $mk ]] && (( pw -= 2 ))
      _cut $name $pw; l1=" $glyph $mk${(r:pw:)REPLY} $C${model}$R${model:+$D · }$D$age$R $( (( att > 0 )) && print -n "$G●$R" || print -n ' ')"
      if [[ -n $waitfor ]]; then _cut "⧗ $waitfor" $(( W - 4 )); l2="   $Y$REPLY$R"
      elif [[ -n $title ]]; then _cut $title $(( W - 4 )); l2="   $M$REPLY$R"
      else l2="   ${D}no task yet$R"; fi
      if [[ -n $branch ]]; then _cut "⎇ $branch${${changed:#0}:+ +$changed} · ${dir:t}" $(( W - 4 ))
      else _cut "${dir:t}" $(( W - 4 )); fi
      l3="   $D$REPLY$R"
      items+=( "$p/$name"$'\t'"$l1"$'\n'"$l2"$'\n'"$l3" )
    done
    # A session that ended leaves no state behind, so a new one with its name starts fresh.
    if [[ -n $track ]]; then
      live=( ${got%%$US*} ); live=( ${${live//\%/%25}//\//%2F} )
      for f in $STATE/(seen|unread)/$p/*(N); do (( ${live[(Ie)${f:t}]} )) || rm -rf $f; done
    fi
  done
  rm -rf $tmp
  if [[ -n $track ]]; then
    # Alerts go out before the new states are kept: a refresh killed in between repeats one, never loses it. The
    # notifier runs in its own process group, off fzf's pipe: fzf killing this refresh, or a slow tone, never stops
    # or holds up either. setsid also takes the terminal from it, so a bell tone rings here, from the refresh.
    local -a det=() snd=()
    if (( $+commands[setsid] )); then det=( setsid ); elif (( $+commands[perl] )); then det=( perl -e 'setpgrp; exec @ARGV' ); fi
    for (( f = 1; f <= $#uf; f++ )); do mkdir -p $uf[f]:h; print -r -- $uv[f] >$uf[f]; done
    if (( $#alerts )); then
      _tone; [[ $reply[1] == bell ]] && { { print -n '\a' >/dev/tty } 2>/dev/null; snd=( LZR1_SOUND=0 ) }
      { env $snd $det $SELF _notify $alerts </dev/null >/dev/null 2>&1 &! }
    fi
    for (( f = 1; f <= $#sf; f++ )); do mkdir -p $sf[f]:h; print -r -- $sv[f] >$sf[f]; done
    [[ -n $seeded ]] || : >$STATE/$1.seeded
    mkdir -p $STATE/seen $STATE/unread; touch $STATE/seen $STATE/unread  # open sweeps what is a day old
    _seen_unlock
  fi
  print -rn -- $'\t'"$n sessions · $w▶ $q⧗ $i·${${a:#0}:+ · $a✱}"$'\0'
  (( $#items )) && print -rn -- ${(pj:\0:)items}$'\0'
  pr_rows $W
}

# first_key ID SKIP...: the first session in the panel's last list, other than the SKIP keys, into REPLY
first_key() {
  local id=$1 it; shift; REPLY=
  for it in "${(@)${(@0)"$(<$STATE/$id.cache 2>/dev/null)"}[2,-1]}"; do
    it=${it%%$'\t'*}
    [[ -z $it || $it == */ || $it == +pr/* || ${@[(Ie)$it]} -gt 0 ]] && continue
    REPLY=$it; return 0
  done
  return 1
}

# remote_last ID KEY: a browser's layout (open, LZR1_REMOTE) shows KEY: the remote's .last keeps it for a reconnect
remote_last() {
  local u; [[ -r $STATE/$1.remote ]] || return 0
  u=$(<$STATE/$1.remote)
  [[ $u == [0-9a-f-]## && -d $RDIR ]] && print -rn -- $2 >$RDIR/$u.last
}

# zoom_pane PANE: PANE alone in its window (the narrow layout, _fit), with the keyboard
zoom_pane() {
  local -a T=(tmux -L lzr1)
  $T select-pane -Z -t $1 2>/dev/null || return 0  # -Z: a zoomed window stays zoomed, on PANE now
  [[ $($T display -p -t $1 '#{window_zoomed_flag}') == 1 ]] || $T resize-pane -Z -t $1 2>/dev/null
}

viewer_detach() {  # viewer_detach ID KEY: detach the viewer's client from KEY's machine
  split_key $2; load $KP 2>/dev/null || return 0
  on 'c=$(cat "$HOME/.cache/lzr1-panel-viewer/$1" 2>/dev/null); [ -n "$c" ] && tmux detach-client -t "$c" 2>/dev/null; true' $1
}

# If the agent exits (Ctrl-C twice, /exit, a crash) its session stays, and Enter runs RESUME: the same conversation.
# Only typing "end" closes it: Ctrl-C and Ctrl-D, easy to hit by accident in a viewer, do not (the trap is a handler,
# so the agent and its commands still get Ctrl-C).
_keep() {  # _keep AGENT FIRST RESUME: the session's command, in REPLY
  REPLY="trap : INT; $2; while :; do printf '\\n  $1 exited. Enter: resume this conversation · type end + Enter: close the session\\n  > '; read -r a || a=; [ \"\$a\" = end ] && break; $3; done"
}

# ---- remote: the panel on your tailnet (docs/remote.md) -------------------------------------------------------------

# ttyd runs a fresh `lzr1-panel open` per browser on a private Unix socket; lzr1-remote-gw (gateway/) checks the
# Tailscale login against the allowlist and the password, then proxies to it; tailscale serve (never funnel) publishes
# the gateway at https://<machine>.<tailnet>.ts.net/<uuid>/. The gateway listens on a 0600 Unix socket, except on
# macOS, where the app's serve cannot reach one: 127.0.0.1 there. $RDIR/session (0600) keeps the URL and password so
# they can be copied again.
RDIR=$STATE/remote
typeset -gA RS  # the session file, key => value

TSBIN=${commands[tailscale]:-/Applications/Tailscale.app/Contents/MacOS/Tailscale}  # PATH, then the macOS app's

# _ts ARGS: the Tailscale CLI
_ts() {
  [[ -x $TSBIN ]] || die "remote needs Tailscale (tailscale.com/download)"
  $TSBIN "$@"
}

# _ts_info: TS_STATE, TS_CERTS (how many HTTPS certificate domains), TS_HOST (this machine's tailnet name), TS_LOGIN
_ts_info() {
  local j
  (( $+commands[jq] )) || die "remote needs jq (./install.sh installs it)"
  j=$(_ts status --json 2>/dev/null)
  local -a f=( "${(@f)$(print -r -- $j | jq -r '(.BackendState // "unknown"), ((.CertDomains // []) | length),
    ((.Self.DNSName // "") | rtrimstr(".")), (.User[(.Self.UserID // 0) | tostring].LoginName // "")' 2>/dev/null)}" )
  TS_STATE=${f[1]:-unknown} TS_CERTS=${f[2]:-0} TS_HOST=$f[3] TS_LOGIN=$f[4]
}

# _ours PID WHAT UUID: PID is still this remote's WHAT (watch, serve, gw or ttyd), told by its full command line, which
# holds the UUID; never by its name alone, so a PID reused by another process (after a reboot, a crash) never matches.
_ours() {
  local a
  [[ $1 == <1-> && -n $3 ]] || return 1
  a=$(ps -ww -o args= -p $1 2>/dev/null) || return 1
  case $2 in
    watch) [[ $a == *" remote watch $3" ]] ;;
    serve) [[ $a == *" serve "*" --set-path /$3 "(http://127.0.0.1:<->/$3|unix:/*) ]] ;;
    gw)    [[ $a == *lzr1-remote-gw" "*" --base /$3/ "* ]] ;;
    ttyd)  [[ $a == *ttyd" "*" -b /$3 "* ]] ;;
    *) return 1 ;;
  esac
}

_remote_read() {  # the session file into RS; false without one
  RS=(); local k v
  [[ -r $RDIR/session ]] || return 1
  while IFS='=' read -r k v; do [[ -n $k ]] && RS[$k]=$v; done <$RDIR/session
  [[ -n $RS[uuid] ]]
}

_remote_save() { local k; ( umask 077; for k in ${(ko)RS}; do print -r -- "$k=$RS[$k]"; done >$RDIR/session ) }

# _stop PID WHAT UUID: TERM, then KILL after 5 s; each signal only while _ours still recognizes the process
_stop() {
  local i
  _ours "$@" || return 0
  kill $1 2>/dev/null
  for i in {1..50}; do _ours "$@" || return 0; sleep 0.1; done
  _ours "$@" && kill -9 $1 2>/dev/null
}

# _remote_funnel HOST: Funnel is on for HOST:443 (0), off (1), or Tailscale cannot say (2)
_remote_funnel() {
  local j; [[ -x $TSBIN ]] || return 2
  j=$($TSBIN serve status --json 2>/dev/null) || return 2
  print -r -- $j | jq -e --arg h $1:443 '[.. | objects | .AllowFunnel? | objects | .[$h]?] | any' >/dev/null
  case $? in 0) return 0 ;; 1) return 1 ;; *) return 2 ;; esac
}

# _remote_published UUID: the tailnet routes /UUID (in any serve config); 1 if not, 2 if Tailscale cannot say
_remote_published() {
  local j; [[ -x $TSBIN ]] || return 1
  j=$($TSBIN serve status --json 2>/dev/null) || return 2
  print -r -- $j | jq -e --arg p /$1 '[.. | objects | .Handlers? | objects | has($p)] | any' >/dev/null
  case $? in 0) return 0 ;; 1) return 1 ;; *) return 2 ;; esac
}

# _remote_off: end the watcher and the foreground serve, stop the gateway, ttyd and the browsers' panels (each process
# only when its command line holds this UUID), then make sure the path is unpublished (serve ... off if it is still
# there) and remove the sockets and the session file. Safe to repeat; uses RS (or reads the session file). When
# Tailscale cannot confirm the path is gone, it keeps the session file, says how to remove the path and returns 1.
_remote_off() {
  local u p n s m r=1
  zmodload zsh/system
  (( $#RS )) || _remote_read
  u=$RS[uuid]
  if [[ -n $u ]]; then
    for p n in "$RS[watchpid]" watch "$RS[servepid]" serve "$RS[gwpid]" gw "$RS[ttydpid]" ttyd; do
      [[ $p != $sysparams[pid] ]] && _stop "$p" $n $u
    done
    tmux -L lzr1 list-sessions -F '#{session_name} #{@lzr1_remote}' 2>/dev/null | while read -r s m; do
      [[ $m == $u ]] && tmux -L lzr1 kill-session -t "=$s" 2>/dev/null
    done
    _remote_published $u; r=$?
    if (( r == 0 )); then
      $TSBIN serve --https=443 --set-path /$u off >/dev/null 2>&1; _remote_published $u; r=$?
    fi
  fi
  rm -f $RDIR/*.sock(N) $RDIR/*.last(N) $RDIR/gw.out $RDIR/gw.pid $RDIR/serve.out $RDIR/serve.pid
  if (( r != 1 )); then
    print -ru2 -- "lzr1-panel: could not unpublish https://${RS[host]:-<this machine>}/$u/ (is Tailscale running?);" \
      "everything else is stopped; kept $RDIR/session. Run lzr1-panel remote off again, or:" \
      "tailscale serve --https=443 --set-path /$u off"
    return 1
  fi
  rm -f $RDIR/session
  RS=()
}

# _remote_live: a session is on (its gateway runs); a stale one (expired, or a reboot) is cleaned up
_remote_live() {
  _remote_read || { RS=(); rm -f $RDIR/session; return 1 }
  _ours "$RS[gwpid]" gw $RS[uuid] && return 0
  _remote_off; return 1
}

# _remote_keeper UUID: on the gateway's stdout. Publishes the address the gateway prints once ready with a foreground
# serve (Tailscale drops the path when that process ends), then waits for the gateway to exit however it ends (--ttl,
# a crash, a kill: its stdout closes) and ends serve, so the path never outlives the gateway even without the watcher.
_remote_keeper() {
  local u=$1 out target
  trap '' HUP INT
  IFS= read -r out; print -r -- $out >$RDIR/gw.out
  case $out in
    "ready 127.0.0.1:"<->) target=http://127.0.0.1:${out##*:}/$u ;;  # serve strips /UUID: put it back
    ready) target=unix:$RDIR/gw.sock ;;
    *) return 0 ;;
  esac
  $TSBIN serve --yes --https=443 --set-path /$u $target </dev/null >$RDIR/serve.out 2>&1 &
  print $! >$RDIR/serve.pid
  cat >/dev/null
  _stop $(<$RDIR/serve.pid) serve $u
}

# _remote_watch UUID: the watcher, a process of its own (`lzr1-panel remote watch UUID`). Every second it turns the
# gateway's new audit lines into alerts (_remote_alert); it turns everything off when the gateway ends (--ttl, the kill
# switch, a crash) or serve does (Tailscale quit), or when Funnel is on for this address (checked every 10 s; a status
# Tailscale cannot give counts as on), and says why. A remote off you type stops it first, so that is never alerted.
_remote_watch() {
  local u=$1 n=0 pos why= fails=0 lastfail=0 ended= flush=
  local -a who
  trap '' HUP INT
  _remote_read && [[ $RS[uuid] == $u ]] || return 0
  pos=${RS[auditpos]:-0}
  while _ours $RS[gwpid] gw $u && _ours $RS[servepid] serve $u; do
    sleep 1
    _remote_audit $pos; pos=$REPLY; _remote_alert $reply
    if (( ++n % 10 == 0 )) && ! { _remote_funnel $RS[host]; (( $? == 1 )) }; then
      print -r -- "lzr1-panel: Funnel is on for $RS[host]:443 (or Tailscale cannot say): turning remote off"
      why=funnel; break
    fi
  done
  # One last read, so a lockout or shutdown written just before the gateway exited is not lost.
  flush=1; _remote_audit $pos; _remote_alert $reply
  if [[ $why == funnel ]]; then _remote_note funnel "Funnel appeared; turned off"
  elif [[ $ended != (killswitch|ttl) ]]; then
    if _ours $RS[gwpid] gw $u; then _remote_note stopped "tailscale serve ended; turned off"
    else _remote_note stopped "the gateway stopped; turned off"; fi
  fi
  _remote_read && [[ $RS[uuid] == $u ]] && _remote_off
}

# _remote_audit POS: the complete lines of $RDIR/audit.log after byte POS into reply, the position after them into
# REPLY. A line still being written (no final newline yet) waits for the next call; a missing file has no lines.
_remote_audit() {
  setopt local_options no_multibyte  # $#c counts bytes
  local c
  reply=(); REPLY=$1
  [[ -r $RDIR/audit.log ]] || return 0
  c=$(tail -c +$(( $1 + 1 )) $RDIR/audit.log 2>/dev/null; print -n .); c=${c%.}
  [[ $c == *$'\n'* ]] || return 0
  c=${c%$'\n'*}$'\n'
  REPLY=$(( $1 + $#c ))
  reply=( ${(f)c} )
}

# _remote_note KIND TEXT: one remote alert (LZR1_REMOTE_NOTIFY=0: none; LZR1_NOTIFY does not silence these). A group
# per kind, so a later alert never replaces one of another kind (terminal-notifier keeps one per group).
_remote_note() { [[ ${LZR1_REMOTE_NOTIFY:-1} == 0 ]] || _notify_one "lzr1 remote" "${RS[host]%%.*}" "$2" lzr1-remote-$1 }

# _remote_alert LINE...: the watcher's audit lines as alerts: a login, a lockout, the kill switch, the TTL; wrong
# passwords as one "N wrong passwords (LOGIN, ...)" at most every 30 s (later ones wait for the next, or for the last
# read, flush). logout and idle-out are recorded only. Only the fixed event names and keys are read, control characters
# are dropped, and values reach the notifier as arguments only. Uses the watcher's fails, who, lastfail, ended, flush.
_remote_alert() {
  zmodload zsh/datetime
  local l kv user reason until; local -a w
  for l in "$@"; do
    w=( ${(s: :)${l//[[:cntrl:]]/}} ); user= reason= until=
    for kv in $w[3,-1]; do
      case $kv in
        user=*) user=${kv#*=} ;;
        reason=*) reason=${kv#*=} ;;
        until=*) until=${kv#*=} ;;
      esac
    done
    case $w[2] in
      login) _remote_note login "$user logged in" ;;
      failure) (( ++fails )); (( ${who[(Ie)$user]} )) || who+=( $user ) ;;
      lockout) [[ $until == (#b)*T([0-9][0-9]:[0-9][0-9])* ]] && until=$match[1]
        _remote_note lockout "$user locked out until $until (5 wrong passwords)" ;;
      shutdown) ended=$reason
        case $reason in
          killswitch) _remote_note killswitch "turned off: 20 wrong passwords" ;;
          ttl) _remote_note ttl "expired, turned off" ;;
        esac ;;
    esac
  done
  if (( fails && ( flush || EPOCHSECONDS - lastfail >= 30 ) )); then
    _cut "${(j:, :)who}" 80
    _remote_note failure "$fails wrong password${${fails:#1}:+s} ($REPLY)"
    fails=0 lastfail=$EPOCHSECONDS; who=()
  fi
}

# _dur VALUE NAME: VALUE (like 8h, 90m or 1h30m) in seconds into REPLY; dies naming NAME, the flag or variable it came
# from, when it is not one or is 0
_dur() {
  local a=$1; REPLY=0
  [[ $a == ([0-9]##[hms])## ]] || die "$2 takes hours, minutes or seconds, like 8h, 90m or 1h30m (got ${(q-)1})"
  while [[ $a == (#b)([0-9]##)([hms])(*) ]]; do
    REPLY=$(( REPLY + match[1] * ${${${match[2]/h/3600}/m/60}/s/1} )); a=$match[3]
  done
  (( REPLY > 0 )) || die "$2 must be more than 0"
}

# _remote_gw: builds the gateway into $RDIR when it is missing or older than its source; its path in REPLY
_remote_gw() {
  local src=${SELF:h:h}/gateway f stale=
  REPLY=$RDIR/lzr1-remote-gw
  [[ -x $REPLY ]] || stale=1
  for f in $src/*.(go|mod|html|js)(N); do [[ $f -nt $REPLY ]] && stale=1; done
  [[ -z $stale ]] && return 0
  (( $+commands[go] )) || die "remote needs Go to build its gateway: brew install go (Linux: your distribution's golang package)"
  mkdir -p $RDIR && chmod 700 $RDIR
  print -r -- "building the gateway (gateway/, Go standard library only)"
  ( cd $src && go build -trimpath -o $REPLY . ) || die "could not build the gateway: cd $src && go build ."
}

_remote_status() {
  zmodload zsh/datetime
  local n=0 s m l t u logins=0 last= fails=0 now left; local -a w lk; local -A locked
  if ! _remote_live; then
    [[ -e $RDIR/session ]] && { print "remote: off, but its path may still be published (above)"; return 1 }
    # Why it is off, when the kill switch did it (the last shutdown in the audit trail).
    [[ -r $RDIR/audit.log ]] && l=$(grep -E '^[^ ]+ shutdown ' $RDIR/audit.log | tail -1)
    if [[ $l == *" reason=killswitch" ]]; then
      print -r -- "remote: off: the kill switch turned it off at ${l[12,16]} (20 wrong passwords; $RDIR/audit.log)"
    else print "remote: off"; fi
    return 0
  fi
  # This remote's logins, failures and lockouts, from its part of the audit trail.
  _remote_audit ${RS[auditpos]:-0}
  for l in $reply; do
    w=( ${(s: :)${l//[[:cntrl:]]/}} ); u=${${(M)w:#user=*}[1]#user=}
    case $w[2] in
      login) (( ++logins )); last=$u t=$w[1] ;;
      failure) (( ++fails )) ;;
      lockout) locked[$u]=${${(M)w:#until=*}[1]#until=} ;;
    esac
  done
  now=$(strftime '%Y-%m-%dT%H:%M:%S' $EPOCHSECONDS)
  for u in ${(ko)locked}; do [[ ${locked[$u][1,19]} > $now ]] && lk+=( "$u until ${locked[$u][12,16]}" ); done
  left=$(( ${RS[expires]:-0} - EPOCHSECONDS ))
  tmux -L lzr1 list-sessions -F '#{session_name} #{@lzr1_remote}' 2>/dev/null | while read -r s m; do
    [[ $m == $RS[uuid] ]] && (( n++ ))
  done
  print -r -- "remote: on"
  print -r -- "  url:      $RS[url]"
  print -r -- "  allowed:  ${RS[allow]//,/, }"
  print -r -- "  expires:  $(strftime '%H:%M' $RS[expires]) (in $(( left / 3600 ))h$(( left % 3600 / 60 ))m)"
  print -r -- "  idle:     a browser is logged out after ${RS[idle]:-30m} without input"
  if (( logins )); then print -r -- "  logins:   $logins (last $last at ${t[12,16]})"; else print -r -- "  logins:   none yet"; fi
  (( fails )) && print -r -- "  failures: $fails${lk:+; locked: ${(j:, :)lk}}"
  print -r -- "  gateway:  pid $RS[gwpid], ${${RS[port]:+127.0.0.1:$RS[port]}:-$RDIR/gw.sock}"
  print -r -- "  serve:    pid $RS[servepid] (the path ends with it; it ends with the gateway)"
  if _ours "$RS[ttydpid]" ttyd $RS[uuid]; then print -r -- "  ttyd:     pid $RS[ttydpid], $n browser(s) connected"
  else print -r -- "  ttyd:     stopped (lzr1-panel remote off, then on)"; fi
}

# ---- commands -------------------------------------------------------------------------------------------------------

case $1 in

start)  # start PROFILE opus|sonnet|opencode NAME [claude or opencode args]
  load $2 || exit 1
  local model=$3 name=$4 agent=claude REPLY
  shift 4 2>/dev/null
  [[ $model == (opus|sonnet|opencode) && -n $name ]] ||
    die 'usage: lzr1-panel start PROFILE opus|sonnet|opencode NAME [claude or opencode args]'
  [[ $name == *[.:/\|]* ]] && die 'session names cannot contain ".", ":", "/" or "|"'
  # LZR1_PROMPT is the first message; a resumed conversation does not get it again, nor your args.
  if [[ $model == opencode ]]; then
    agent=opencode
    local oc="${(q)P_OPENCODE} --auto" args=${(j: :)${(q)@}}
    _keep opencode "$oc${args:+ $args}${LZR1_PROMPT:+ --prompt ${(q)LZR1_PROMPT}}" "$oc --continue"
  else
    local claude="${(q)P_CLAUDE} --model $model --dangerously-skip-permissions --effort medium --remote-control ${(q)name} ${(j: :)${(q)@}}"
    _keep Claude "$claude ${LZR1_PROMPT:+${(q)LZR1_PROMPT}}" "$claude --continue"
  fi
  local cmd=$REPLY
  print -r -- "starting: $name on $P_NAME"
  on "$EXP"'
    name=$1 cmd=$2 root=$(exp "$3") repos=$(exp "$4")
    if tmux has-session -t "=$name" 2>/dev/null; then echo "already running"; exit 0; fi
    dir=$root inrepo=
    if [ -n "$repos" ] && [ -d "$repos/$name" ]; then dir=$repos/$name inrepo=1
    # A session about a pull request, REPO-prN, opens in REPO.
    elif [ -n "$repos" ] && [ -d "$repos/${name%-pr*}" ]; then dir=$repos/${name%-pr*} inrepo=1; fi
    [ -d "$dir" ] || dir=$HOME
    echo "folder: $dir"
    tmux new-session -d -s "$name" -c "$dir" -x 200 -y 50 "$cmd" || exit 1
    tmux set-option -t "=$name:" @lzr1_model "$5"
    # opencode asks no folder trust and has no Remote Control link: started once it outlives its first 2s.
    if [ "$6" = opencode ]; then
      tmux set-option -t "=$name:" @lzr1_agent opencode; sleep 2
      if ! tmux has-session -t "=$name" 2>/dev/null || tmux capture-pane -p -J -t "=$name:" | grep -q "opencode exited"
      then echo "opencode exited right after start"; exit 1; fi
      echo started; exit 0
    fi
    trusted= i=0
    while [ $i -lt 15 ]; do
      i=$((i + 1)); sleep 1
      tmux has-session -t "=$name" 2>/dev/null || { echo "claude exited right after start"; exit 1; }
      screen=$(tmux capture-pane -p -J -t "=$name:")
      # First run in a repository: Claude asks whether to trust the folder, defaulting to "No, exit".
      if [ -n "$inrepo" ] && [ -z "$trusted" ] && printf "%s" "$screen" | grep -q "Yes, I trust this folder"; then
        tmux send-keys -t "=$name:" Down Enter; trusted=1; echo "trusted the repository folder (first run)"; continue
      fi
      url=$(printf "%s" "$screen" | grep -o "https://claude.ai/code/session_[A-Za-z0-9]*" | tail -1)
      if [ -n "$url" ]; then tmux set-option -t "=$name:" @rc_url "$url"; echo "remote control: $url"; exit 0; fi
    done
    echo "started (Remote Control link not shown yet)"' "$name" "$cmd" "${P_ROOT:-${P_REPOS:-~}}" "$P_REPOS" "$model" $agent
  ;;

prs)  # your open pull requests, fresh
  rm -f $STATE/prs; prs_refresh
  local it; for it in "${(@0)$(pr_rows ${COLUMNS:-80})}"; do [[ -n $it ]] && print -r -- ${it#*$'\t'}; done
  [[ -s $STATE/prs ]] || print -ru2 -- "lzr1-panel: no GitHub account found (sign in with: gh auth login)"
  ;;

doctor)  # checks this computer, GitHub and every profile, with the fix for anything missing
  local bad=0 v login p GC="$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  local -a all=( $(profiles) )
  _ok()   { print -r -- "  ✓ $*" }
  _no()   { print -r -- "  ✗ $*"; bad=1 }
  _hint() { print -r -- "      → $*" }
  autoload -Uz is-at-least
  print "this computer"
  for v in zsh tmux git curl openssl; do
    (( $+commands[$v] )) && _ok $v || { _no "$v is missing"; _hint "./install.sh installs it" }
  done
  v=$(fzf --version 2>/dev/null); v=${v%% *}
  if [[ -n $v ]] && is-at-least 0.74 $v; then _ok "fzf $v"
  else _no "fzf ${v:-is missing} (0.74 or newer is needed)"; _hint "./install.sh installs it"; fi
  # Optional, like run --opencode finds it: without it only opencode sessions are unavailable.
  v=${commands[opencode]:-$HOME/.opencode/bin/opencode}
  if [[ -x $v ]]; then v=${${=$($v --version 2>/dev/null)}[-1]}; _ok "opencode${v:+ ${v#v}}"
  else print "  · no opencode: opencode sessions unavailable"; _hint "brew install sst/tap/opencode, or see opencode.ai"; fi
  if [[ $OSTYPE == darwin* ]]; then
    if [[ -d /Applications/Ghostty.app ]]; then
      _ok "Ghostty"
      if grep -qsF 'performable:ctrl+c=copy_to_clipboard' $GC ~/.config/ghostty/config(|.ghostty)(N); then
        _ok "Ghostty: Ctrl+C copies a selection"
      else print "  · Ghostty: Ctrl+C does not copy yet"; _hint "./install.sh offers it"; fi
    else print "  · no Ghostty: the panel opens as a tmux layout"; fi
  fi
  print "\ngithub (the pull requests under your sessions)"
  if [[ ${LZR1_PRS:-1} == 0 ]]; then print "  · hidden (LZR1_PRS=0)"
  elif (( $+commands[gh] )) && login=$(gh api user -q .login 2>/dev/null); then _ok "gh is signed in as $login"
  else
    login=$(ssh -T -o BatchMode=yes -o ConnectTimeout=5 git@github.com 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p')
    if [[ -n $login ]] && (( $+commands[jq] )); then
      _ok "your SSH key belongs to $login (public PRs only)"; _hint "for every PR, with checks and reviews: gh auth login"
    else
      _no "no GitHub account found"
      (( $+commands[gh] )) && _hint "run: gh auth login" || _hint "./install.sh installs gh and signs you in"
    fi
  fi
  # Informational only: a computer without a notifier still runs the panel.
  print "\nalerts (a tone and a notification when a session needs you)"
  [[ ${LZR1_SOUND:-1} == 0 ]] && print "  · tone off (LZR1_SOUND=0)"
  [[ ${LZR1_NOTIFY:-1} == 0 ]] && print "  · notifications off (LZR1_NOTIFY=0)"
  _tone
  if [[ $reply[1] == bell ]]; then print "  · tone: terminal bell (no default sound for paplay, no canberra-gtk-play)"
  elif (( $#reply )); then _ok "tone: $reply[1]"
  elif [[ ${LZR1_SOUND:-1} != (0|1) && ! -r $LZR1_SOUND ]]; then print -r -- "  · tone: cannot read $LZR1_SOUND"
  elif [[ ${LZR1_SOUND:-1} == 1 ]]; then print "  · no tone: the default sound is missing"
  elif [[ $LZR1_SOUND != 0 ]]; then print -r -- "  · no tone: no paplay or canberra-gtk-play for $LZR1_SOUND"; fi
  if [[ $OSTYPE == darwin* ]]; then
    if [[ ${LZR1_NOTIFY:-1} != 0 ]]; then
      if (( $+commands[terminal-notifier] )); then _ok "notifications: terminal-notifier"
      else print "  · notifications: osascript"; _hint "brew install terminal-notifier (groups them per session)"; fi
    fi
  else
    if [[ ${LZR1_NOTIFY:-1} != 0 ]]; then
      if (( ! $+commands[notify-send] )); then
        print "  · no notify-send"; _hint "install libnotify (libnotify-bin on Debian/Ubuntu)"
      elif [[ -z $DISPLAY$WAYLAND_DISPLAY ]]; then
        print "  · notify-send, but no \$DISPLAY or \$WAYLAND_DISPLAY here: no notifications"
      else _ok "notifications: notify-send"; fi
    fi
  fi
  _hint "lzr1-panel notify sends a test"
  print "\nprofiles"
  (( $#all )) || { _no "no profiles yet"; _hint "lzr1-panel profile add" }
  for p in $all; do profile_test $p | sed 's/^/  /' || bad=1; done
  if (( bad )); then print "\n  something needs fixing: see docs/troubleshooting.md"; else print "\n  all good"; fi
  exit $bad
  ;;

run)  # run [--model ID] [--effort E] [--opencode] [--name NAME] [claude or opencode args]: Claude (or opencode) in a new
     # tmux session in this folder, attached; the panel lists it only inside a profile's repositories folder
  shift
  local model= effort= name= oc= fam sock REPLY
  while (( $# )); do
    case $1 in
      --model) model=$2; shift 2 ;;
      --effort) effort=$2; shift 2 ;;
      --name) name=$2; shift 2 ;;
      --opencode) oc=1; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  local cl=${commands[claude]:-$HOME/.local/bin/claude}
  if [[ -n $oc ]]; then
    [[ -n $model ]] && die 'run --opencode: --model is for Claude'
    [[ -n $effort ]] && die 'run --opencode: --effort is for Claude'
    cl=${commands[opencode]:-$HOME/.opencode/bin/opencode}
    # Not a conversation (help, version, a subcommand such as run or session, piped input or output), or no tmux:
    # plain opencode, here.
    if (( ${@[(I)(-v|--version|-h|--help)]} )) || [[ $1 == [a-z]* && $1 != */* && ! -d $1 ]] ||
       [[ ! -t 0 || ! -t 1 ]] || ! (( $+commands[tmux] )); then
      exec $cl "$@"
    fi
  fi
  effort=${effort:-medium}
  # Not a conversation (print mode, help, version, piped input or output), or no tmux: plain claude, here.
  if (( ${@[(I)(-p|--print|--print=*|-v|--version|-h|--help)]} )) || [[ ! -t 0 || ! -t 1 ]] || ! (( $+commands[tmux] )); then
    exec $cl ${model:+--model} ${model:+$model} --dangerously-skip-permissions --effort $effort "$@"
  fi
  # Named after this folder: lerian-clients, then lerian-clients-2 when that one is taken.
  local base=${${name:-${PWD:t}}//[.:\/|]/-} n=1
  name=$base
  while env -u TMUX tmux has-session -t "=$name" 2>/dev/null; do (( n++ )); name=$base-$n; done
  # As in start: the session outlives its agent and Enter resumes the conversation; your args go to the first run only.
  if [[ -n $oc ]]; then
    _keep opencode "${(q)cl} --auto ${(j: :)${(q)@}}" "${(q)cl} --auto --continue"
  else
    local claude="${(q)cl}${model:+ --model ${(q)model}} --dangerously-skip-permissions --effort ${(q)effort} --remote-control ${(q)name}"
    _keep Claude "$claude ${(j: :)${(q)@}}" "$claude --continue"
  fi
  env -u TMUX tmux new-session -d -s "$name" -c "$PWD" -x ${COLUMNS:-200} -y ${LINES:-50} "$REPLY" || die "cannot start tmux"
  case $model in *opus*) fam=opus ;; *sonnet*) fam=sonnet ;; *haiku*) fam=haiku ;; *fable*) fam=fable ;; *) fam=$model ;; esac
  [[ -n $oc ]] && fam=opencode && env -u TMUX tmux set-option -t "=$name:" @lzr1_agent opencode
  [[ -n $fam ]] && env -u TMUX tmux set-option -t "=$name:" @lzr1_model $fam
  env -u TMUX sh -c "$CLIP"
  # Already inside this machine's own tmux: switch to the session; anywhere else, attach to it.
  sock=$(env -u TMUX tmux display -p -t "=$name:" '#{socket_path}' 2>/dev/null)
  if [[ -n $TMUX && ${TMUX%%,*} == $sock ]]; then tmux switch-client -t "=$name"
  else exec env -u TMUX tmux attach -t "=$name"; fi
  ;;

attach)  # attach PROFILE NAME: this terminal into a session (Ctrl-b d leaves it)
  [[ -n $3 ]] || die 'usage: lzr1-panel attach PROFILE NAME'
  exec $SELF _attach "$2/$3"
  ;;

list)
  local it; for it in "${(@0)$(list_rows)}"; do [[ -n $it ]] && print -r -- ${it#*$'\t'}; done
  ;;

_list)  # _list ID: rows for fzf, cached for _pos
  list_rows $2 | tee $STATE/$2.cache
  ;;

profile)
  shift
  case $1 in
    list|ls|'')
      local p; local -a all=( $(profiles) )
      for p in $all; do load $p && print -r -- "$p  $P_TYPE${P_HOST:+  $P_HOST}  repos=$P_REPOS${P_ONLY:+  only=$P_ONLY}"; done
      (( $#all )) || print "no profiles yet: lzr1-panel profile add"
      ;;
    show) load $2 && { print -r -- "# $PROFILES/$2.conf"; grep -v '^#' $PROFILES/$2.conf } ;;
    add) shift; profile_add "$@" ;;
    edit) profile_edit $2 ;;
    test) profile_test $2 ;;
    remove|rm) [[ -e $PROFILES/$2.conf ]] || die "no profile '$2'"; rm -f $PROFILES/$2.conf; print "removed $2" ;;
    *) profile_help ;;
  esac
  ;;

open)  # panel on the left, viewer on the right
  local id=$$ term
  # A reused ID is a new panel: its first refresh only records, it starts wide, and it is not a browser's layout.
  rm -rf $STATE/^remote(Nmd+1) $STATE/$id.seeded $STATE/$id.narrow $STATE/$id.fit $STATE/$id.remote
  lzr1_splash open
  if [[ $OSTYPE == darwin* && ( $TERM_PROGRAM == ghostty || -n $GHOSTTY_RESOURCES_DIR ) && -z $TMUX ]]; then
    # Ghostty: split this pane; it becomes the viewer.
    term=$(ghostty 'get id of focused terminal of selected tab of front window') || die "cannot script Ghostty"
    print -rn -- ghostty >$STATE/$id.mode
    print -rn -- $term >$STATE/$id.vterm
    ghostty "set cfg to new surface configuration
      set command of cfg to \"$SELF _panel $id\"
      $(genv)
      set p to split (terminal id \"$term\") direction left with configuration cfg
      return id of p" >$STATE/$id.me || die "cannot split the Ghostty pane"
    exec $SELF _viewer $id
  fi
  # Anywhere else: a tmux layout on its own server, with no prefix key, so every key reaches the panel,
  # the viewer or Claude; the mouse picks a pane.
  command -v tmux >/dev/null || die "needs tmux"
  local -a T=(tmux -L lzr1 -f /dev/null)
  local sess=lzr1-$id vpane clip=
  # Copies made inside (Claude Code's own, or a session's tmux on any machine) arrive here as OSC 52: put them on
  # this computer's clipboard ourselves, since not every terminal does. This layout's own hook, not the server's: a
  # browser's layout (remote) on the same server sends them on to the browser's clipboard (gateway/client.js) only.
  if (( $+commands[pbcopy] )); then clip=pbcopy
  elif [[ -n $WAYLAND_DISPLAY ]] && (( $+commands[wl-copy] )); then clip=wl-copy
  elif [[ -n $DISPLAY ]] && (( $+commands[xclip] )); then clip='xclip -selection clipboard'; fi
  # The lzr1 server exits with its last layout. A layout starting while it does (a browser reconnecting as its old
  # layout ends) is refused ("server exited unexpectedly"), or its session goes with the server: try again.
  local n r err
  for r in 1 2 3; do
    n=0
    until err=$($T new-session -d -s $sess -x ${COLUMNS:-200} -y ${LINES:-50} "$SELF _viewer $id" 2>&1); do
      (( ++n < 20 )) || die "${err:+$err; }cannot start tmux"
      sleep 0.25
    done
    # Copies reach the terminal (set-clipboard). tmux's own double and triple click select the pane under the mouse
    # after a delay, taking the keyboard back from the viewer that a double-click on a row just gave it: the same
    # bindings without select-pane (a single click still selects the pane).
    $T set -g prefix None \; set -g prefix2 None \; set -g mouse on \; set -g status off \; set -g escape-time 10 \
       \; set -g default-terminal tmux-256color \; set -ga terminal-overrides ',*:RGB' \
       \; set -s set-clipboard on \; set -s 'terminal-features[90]' '*:clipboard' \
       \; bind -n DoubleClick1Pane if -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send -M' \
           'copy-mode -H ; send -X select-word ; run -d0.3 ; send -X copy-pipe-and-cancel' \
       \; bind -n TripleClick1Pane if -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send -M' \
           'copy-mode -H ; send -X select-line ; run -d0.3 ; send -X copy-pipe-and-cancel' >/dev/null 2>&1
    $T has-session -t "=$sess" 2>/dev/null && break
    (( r < 3 )) || die "cannot start tmux"
  done
  [[ -n $clip && -z $LZR1_REMOTE ]] && $T set-hook -t $sess pane-set-clipboard "run-shell -b 'tmux save-buffer - | $clip'"
  # A browser's layout: _select keeps its pick in the remote's .last, so a reconnecting browser comes back to it.
  [[ -n $LZR1_REMOTE ]] && print -rn -- $LZR1_REMOTE >$STATE/$id.remote
  vpane=$($T display -p -t $sess '#{pane_id}')
  print -rn -- tmux >$STATE/$id.mode
  print -rn -- $TERM_PROGRAM >$STATE/$id.term
  print -rn -- $vpane >$STATE/$id.vterm
  $T split-window -hb -l $PANEL_W -t $sess -P -F '#{pane_id}' "$SELF _panel $id" >$STATE/$id.me
  # Narrow (a phone in a browser, a small terminal): one pane at a time, the panel first (_fit, on every attach and
  # resize, so a phone turned sideways follows). A tap on the status line it shows brings the panel back (_back).
  if (( NARROW )); then
    local envs="LZR1_CONFIG=${(q)CONFIG} XDG_CACHE_HOME=${(q)STATE:h} LZR1_PANEL_WIDTH=$PANEL_W LZR1_NARROW=$NARROW"
    $T set-hook -t $sess client-attached "run-shell -b '$envs $SELF _fit $id'" \
       \; set-hook -t $sess client-resized "run-shell -b '$envs $SELF _fit $id'" \
       \; bind -n MouseDown1Status "run-shell '$envs $SELF _back #{session_name}'" \
       \; bind -n MouseDown1StatusLeft "run-shell '$envs $SELF _back #{session_name}'" \
       \; bind -n MouseDown1StatusRight "run-shell '$envs $SELF _back #{session_name}'" \
       \; bind -n MouseDown1StatusDefault "run-shell '$envs $SELF _back #{session_name}'" >/dev/null 2>&1
  fi
  # A browser's panel (lzr1-panel remote): its layout ends when the browser goes, and remote off finds it by the mark.
  [[ -n $LZR1_REMOTE ]] &&
    TMUX= exec $T attach -t $sess \; set -t $sess destroy-unattached on \; set -t $sess @lzr1_remote $LZR1_REMOTE
  TMUX= exec $T attach -t $sess
  ;;

_viewer)  # _viewer ID: attaches to whatever the panel picked, waits when nothing is picked
  local id=$2 target n gone cur
  local -a ended hold
  local tfile=$STATE/$id.target
  trap 'rm -f $tfile $tfile.want $tfile.detached $tfile.on $STATE/$id.vpid' EXIT
  print -rn -- $$ >$STATE/$id.vpid; rmdir $STATE/$id.spawn 2>/dev/null
  printf '\e]2;lzr1 viewer\a'
  while true; do
    target=$(<$tfile 2>/dev/null)
    if [[ -z $target ]]; then
      [[ -e $STATE/$id.narrow ]] && zoom_pane $(<$STATE/$id.me)  # narrow: nothing to show, so the panel
      clear; print -P '\n  %F{8}← pick a session in the panel: click it, or use the arrow keys%f'
      print -P '  %F{8}inside a session, Ctrl-b d leaves it (Ctrl-C goes to Claude)%f'
      until [[ -s $tfile ]]; do sleep 0.3; done
      continue
    fi
    clear
    split_key $target
    gone=
    if load $KP; then
      # Only a session the panel just created gets waited for (up to 30s), and a click elsewhere ends the wait.
      hold=( $STATE/$id.hold(Nms-30) )
      if [[ -n $hold && $(<$hold) == $target ]]; then
        n=0
        until on 'tmux has-session -t "=$1"' $KS 2>/dev/null; do
          [[ $(<$tfile 2>/dev/null) == $target ]] || continue 2
          (( n++ == 0 )) && print -r -- $'\n'"  starting $KS ..."
          (( n > 60 )) && { print -r -- "  $KS did not start"; sleep 2; break }
          sleep 0.5
        done
      fi
      # .on: the session this viewer's client is on. A pick on the same machine switches the client in place
      # (_select), and a rename changes the name: both update it.
      print -rn -- $target >$tfile.on
      on -t '
        tmux has-session -t "=$2" 2>/dev/null || exit 3
        mkdir -p "$HOME/.cache/lzr1-panel-viewer" && tty >"$HOME/.cache/lzr1-panel-viewer/$1"
        '"$CLIP"'
        unset TMUX
        exec tmux attach -t "=$2"' $id $KS || true
      # Still on the current pick (Ctrl-b d, or it ended, after a switch in place): that is the session left.
      cur=; [[ -r $tfile.on ]] && cur=$(<$tfile.on)
      [[ -n $cur && -r $tfile && $cur == $(<$tfile) ]] && { target=$cur; split_key $target }
      on 'tmux has-session -t "=$1"' $KS 2>/dev/null || gone=1
    else
      sleep 3
    fi
    [[ $(<$tfile 2>/dev/null) == $target ]] || { ended=(); continue }  # the panel already moved on
    if [[ -n $gone ]]; then
      # The session ended (from the menu, x, "end" typed in it, or anywhere else): show the first one left, and
      # have the panel's ticker move the highlight there.
      ended+=( $target )
      if first_key $id $ended; then
        print -rn -- $REPLY >$tfile; print -rn -- $REPLY >$STATE/$id.follow; remote_last $id $REPLY
      else ended=(); : >$tfile; fi
      [[ -e $STATE/$id.narrow ]] && zoom_pane $(<$STATE/$id.me)  # narrow: back to the list
      continue
    fi
    # Detached (Ctrl-b d): wait for the next pick. The panel's refreshes re-send its highlighted row; .detached
    # keeps them from reattaching it.
    ended=()
    print -rn -- $target >$tfile.detached; : >$tfile
  done
  ;;

_select)  # _select ID KEY [force]: point the viewer at KEY (debounced, so arrowing through rows stays cheap)
  local id=$2 key=$3 tfile=$STATE/$2.target
  split_key $key
  [[ -z $KP || -z $KS || $KP == +pr ]] && exit 0
  # A click on another row, enter or a new session brings back a viewer pane that was closed.
  if [[ $4 == force || $(<$tfile 2>/dev/null) != $key ]] && ! kill -0 $(<$STATE/$id.vpid 2>/dev/null) 2>/dev/null; then
    print -rn -- $key >$tfile; _fname $KS; rm -f $STATE/unread/$KP/$REPLY; remote_last $id $key
    $SELF _respawn $id
    exit 0
  fi
  [[ $(<$tfile 2>/dev/null) == $key ]] && exit 0
  # Right after a new session, the panel's refresh briefly re-sends the old row: ignore it for 3s.
  local -a hold=( $STATE/$id.hold(Nms-3) )  # globbed here: [[ ]] does not glob
  [[ $4 != force && -n $hold && $(<$hold) != $key ]] && exit 0
  # The session the viewer was detached from comes back only on enter or a double-click.
  [[ $4 != force && $(<$tfile.detached 2>/dev/null) == $key ]] && exit 0
  rm -f $tfile.detached
  print -rn -- $key >$tfile.want
  sleep 0.35
  [[ $(<$tfile.want 2>/dev/null) == $key ]] || exit 0
  local was=$(<$tfile 2>/dev/null)
  print -rn -- $key >$tfile; _fname $KS; rm -f $STATE/unread/$KP/$REPLY; remote_last $id $key
  [[ -z $was ]] && exit 0  # an idle viewer picks the target up by itself
  if [[ ${was%%/*} == $KP ]]; then
    # Same machine: switch the attached client in place; .on tells the viewer its client is on KEY now.
    load $KP && [[ $(on '
      c=$(cat "$HOME/.cache/lzr1-panel-viewer/$1" 2>/dev/null)
      [ -n "$c" ] && tmux list-clients -F "#{client_tty}" | grep -qx "$c" && tmux switch-client -c "$c" -t "=$2" &&
        echo switched
      true' $id $KS) == switched ]] && print -rn -- $key >$tfile.on
  else
    # Another machine: let go of the old one; the viewer then attaches the new target.
    viewer_detach $id $was
  fi
  ;;

_ticker)  # _ticker ID PORT: show the first session in the viewer (a reconnecting browser: the one it showed), then
         # reload the panel every 15s while it is alive
  local id=$2 port=$3
  ( local i u last=
    local -a keys
    [[ -r $STATE/$id.remote ]] && u=$(<$STATE/$id.remote) && [[ -r $RDIR/$u.last ]] && last=$(<$RDIR/$u.last)
    for i in {1..50}; do
      keys=( ${(f)"$(curl -sf -m 2 -H "x-api-key: $FZF_API_KEY" "localhost:$port?limit=200" |
        grep -o '"text":"[^"]*' | sed 's/^"text":"//; s/\\t.*//' | grep -v '/$' | grep '/' | grep -v '^+pr/')"} )
      if (( $#keys )); then
        if [[ -n $last && ${keys[(Ie)$last]} -gt 0 ]]; then $SELF _select $id $last; $SELF _pos $id $port $last &
        else $SELF _select $id $keys[1]; fi
        break
      fi
      sleep 0.2
    done
    # Every second: follow the viewer when it moved on by itself (a session ended); every 15s: reload.
    local n=0 key
    while sleep 1; do
      if [[ -s $STATE/$id.follow ]]; then
        key=$(<$STATE/$id.follow); rm -f $STATE/$id.follow
        $SELF _pos $id $port $key &
      fi
      (( ++n % 15 )) && continue
      curl -sf -m 5 -H "x-api-key: $FZF_API_KEY" -XPOST "localhost:$port" -d "reload($SELF _list $id)" || exit 0
    done ) >/dev/null 2>&1 &!
  ;;

_pos)  # _pos ID PORT KEY: move the panel's highlight to KEY once the panel lists it (tries for ~6s)
  local id=$2 port=$3 key=$4 i line api=(curl -s -m 2 -H "x-api-key: $FZF_API_KEY" "localhost:$3")
  repeat 20; do
    sleep 0.3
    $api -XPOST -d "reload($SELF _list $id)" >/dev/null
    sleep 0.5
    i=0
    local -a its=( "${(@0)$(<$STATE/$id.cache)}" )
    for line in "${(@)its[2,-1]}"; do
      [[ -n $line ]] || continue
      (( i++ )); [[ ${line%%$'\t'*} == $key ]] || continue
      print -rn -- $key >$STATE/$id.target.want
      $api -XPOST -d "pos($i)" >/dev/null; sleep 0.2
      [[ $($api "?limit=1" | grep -o '"current":{[^}]*' ) == *"\"text\":\"$key\\t"* ]] && exit 0
    done
  done
  ;;

_new)  # _new opus|sonnet|opencode ID KEY [NAME [PROMPT]]: type a name on KEY's profile (or take NAME); starts in the background,
       # shows it in the viewer; PROMPT is the first message
  local model=$2 id=$3 p=${4%%/*} name=$5 prompt=$6
  # Only the machines that answered on the last refresh.
  local -a all=( ${${(M)${(@0)"$(<$STATE/$id.cache)"}:#[^+/]##/$'\t'*}%%/*} )
  (( $#all )) || all=( $(profiles) )
  [[ -n $p && -e $PROFILES/$p.conf ]] || p=${all[1]}
  if (( $#all > 1 )); then
    # Several machines: confirm which one, starting from the highlighted row's.
    p=$(print -rl -- $p ${all:#$p} | fzf --layout=reverse --prompt="new $model on › " --info=hidden \
          --gutter=' ' --pointer='▌' --highlight-line --color='pointer:yellow,current-fg:bold' \
          --header='click a machine · esc cancels' --header-border=bottom \
          --bind 'left-click:accept,double-click:accept') || exit 0
  fi
  [[ -n $p ]] || { print "no profiles yet: lzr1-panel profile add — press a key"; read -k1 -s; exit 0 }
  load $p || { read -k1 -s; exit 0 }
  # Type a name and press enter, or click a repository. Enter with nothing typed takes the highlighted one.
  local -a picked
  [[ -z $name ]] && picked=( "${(@f)$(on "$EXP"'ls -1 "$(exp "$1")" 2>/dev/null' $P_REPOS |
    fzf --layout=reverse --print-query --prompt="new $model on $p › " --info=hidden --no-sort \
      --gutter=' ' --pointer='▌' --highlight-line --color='pointer:yellow,current-fg:bold' \
      --header=$'type a name ↵ or click a repo\nrepos open in their own folder' \
      --header-border=bottom \
      --bind 'enter:transform:[ -n {q} ] && echo print-query || echo accept' \
      --bind 'tab:replace-query,left-click:accept,double-click:accept,esc:abort')}" )
  [[ -z $name ]] && name=${picked[2]:-${picked[1]}}
  [[ -z $name ]] && exit 0
  if [[ $name == *[.:/\|]* ]]; then
    print -r -- 'session names cannot contain ".", ":", "/" or "|" — press a key'; read -k1 -s; exit 0
  fi
  LZR1_PROMPT=$prompt $SELF start $p $model $name >$STATE/$id.startlog 2>&1 &!
  # Back to the list as soon as tmux has the session; the viewer shows Claude starting in it.
  if ! on 'i=0; while [ $i -lt 100 ]; do tmux has-session -t "=$1" 2>/dev/null && exit 0; i=$((i + 1)); sleep 0.1; done; exit 1' $name; then
    print -r -- "could not start $name:"; cat $STATE/$id.startlog; print "press a key"; read -k1 -s; exit 0
  fi
  print -rn -- "$p/$name" >$STATE/$id.hold
  $SELF _select $id "$p/$name" force
  # The panel reloads after this returns; then its highlight moves to the new row.
  $SELF _pos $id $FZF_PORT "$p/$name" >/dev/null 2>&1 &!
  ;;

_respawn)  # _respawn ID: open a new viewer pane to the right of the panel
  local id=$2 me=$(<$STATE/$2.me 2>/dev/null)
  [[ -z $me ]] && exit 0
  rmdir $STATE/$id.spawn(Nms+10) 2>/dev/null
  mkdir $STATE/$id.spawn 2>/dev/null || exit 0
  if [[ $(mode $id) == tmux ]]; then
    tmux -L lzr1 split-window -h -t $me -P -F '#{pane_id}' "$SELF _viewer $id" >$STATE/$id.vterm.new
  else
    ghostty "set cfg to new surface configuration
      set command of cfg to \"$SELF _viewer $id\"
      $(genv)
      set v to split (terminal id \"$me\") direction right with configuration cfg
      return id of v" >$STATE/$id.vterm.new
  fi && mv $STATE/$id.vterm.new $STATE/$id.vterm
  ;;

_unclick)  # _unclick ID PANE: after a row's menu in the tmux layout (see _panel): a button release typed into the
           # panel, then the menu's reload, sent once fzf has read that release (it drops input while it reloads)
  tmux -L lzr1 send-keys -t $3 -l $'\e[<0;1;1m' 2>/dev/null
  { sleep 0.2
    curl -s -m 5 -H "x-api-key: $FZF_API_KEY" -XPOST "localhost:$FZF_PORT" -d "reload-sync($SELF _list $2)"
  } >/dev/null 2>&1 &!
  ;;

_focus)  # _focus ID: move the keyboard to the viewer (narrow: the viewer alone)
  local vt=$(<$STATE/$2.vterm 2>/dev/null)
  [[ -z $vt ]] && exit 0
  if [[ $(mode $2) == tmux ]]; then
    if [[ -e $STATE/$2.narrow ]]; then zoom_pane $vt; else tmux -L lzr1 select-pane -t $vt; fi
  else ghostty "focus (terminal id \"$vt\")" >/dev/null; fi
  ;;

_fit)  # _fit ID: the tmux layout's hooks (open): under NARROW columns the panel or the viewer alone, with a status line
       # to come back to the panel; wide, the panel PANEL_W columns beside the viewer
  local id=$2 s=lzr1-$2 me w z
  local -a T=(tmux -L lzr1)
  [[ -r $STATE/$id.me ]] && me=$(<$STATE/$id.me)
  [[ -n $me ]] || exit 0
  # One at a time (an attach and a resize come together), each reading the width when its turn comes: the last wins.
  repeat 40; do mkdir $STATE/$id.fit 2>/dev/null && break; sleep 0.05; done
  trap 'rmdir $STATE/$id.fit 2>/dev/null' EXIT
  w=$($T display -p -t "=$s:" '#{window_width} #{window_zoomed_flag}' 2>/dev/null) || exit 0
  z=${w#* } w=${w% *}
  if (( NARROW && w < NARROW )); then
    : >$STATE/$id.narrow
    $T set -t $s status on \; set -t $s status-position bottom \; set -t $s status-style 'fg=black,bg=yellow' \
       \; set -t $s status-left ' ◀ panel · tap here' \; set -t $s status-left-length 40 \; set -t $s status-right '' \
       \; set -t $s window-status-format '' \; set -t $s window-status-current-format '' 2>/dev/null
    (( z )) || zoom_pane $me  # already zoomed (the panel, or the viewer showing a session): keep it
  else
    [[ -e $STATE/$id.narrow ]] || (( ! z )) || exit 0  # never unzoom what this did not zoom
    rm -f $STATE/$id.narrow
    (( z )) && $T resize-pane -Z -t $me 2>/dev/null
    $T set -t $s status off \; resize-pane -t $me -x $PANEL_W 2>/dev/null
  fi
  ;;

_back)  # _back SESSION: a tap on a narrow layout's status line: the panel alone again
  local id=${2#lzr1-}
  [[ $2 == lzr1-<-> && -e $STATE/$id.narrow && -r $STATE/$id.me ]] && zoom_pane $(<$STATE/$id.me)
  ;;

_url)  # _url KEY: the session's Remote Control link
  split_key $2; [[ -n $KS ]] || exit 0
  load $KP && on 'tmux show-options -v -t "=$1:" @rc_url 2>/dev/null' $KS
  ;;

_open_url)  # _open_url KEY: a session's Remote Control link, or a PR
  local u
  split_key $2
  if [[ $KP == +pr ]]; then u=$KS; else u=$($SELF _url $2); fi
  [[ -n $u ]] && browse $u
  ;;

_go)  # _go ID KEY: enter and double-click; a session goes to the viewer with the keyboard, a PR opens in the browser
  split_key $3
  if [[ $KP == +pr ]]; then [[ -n $KS ]] && browse $KS
  else $SELF _select $2 $3 force; $SELF _focus $2; fi
  ;;

_footer)  # _footer ID: fzf's action for a click on the footer word $FZF_CLICK_FOOTER_WORD. The row's key stays a {1}
         # that fzf fills in, quoted, when it runs the action: the transform's own text never holds a session's name.
  local more="+reload-sync($SELF _list $2)"
  case $FZF_CLICK_FOOTER_WORD in
    *opencode*) print -r -- "execute($SELF _new opencode $2 {1})$more" ;;
    *opus*)     print -r -- "execute($SELF _new opus $2 {1})$more" ;;
    *sonnet*)   print -r -- "execute($SELF _new sonnet $2 {1})$more" ;;
    *↻*)        print -r -- "reload-sync($SELF _list $2)" ;;
    *\?*)       print -r -- "execute($SELF keys; read -k1 -s)" ;;
  esac
  ;;

_tap)  # _tap ID KEY: a left click on a row; in the narrow layout a session's row shows it, as enter does
  [[ -e $STATE/$2.narrow ]] || exit 0
  case $3 in +pr/*|*/) ;; */?*) $SELF _go $2 $3 ;; esac
  ;;

_kill)  # _kill KEY [ID]: end the session (Claude and its tmux session); with ID, the panel and the viewer then move
       # to the first session left
  local id=$3 next= it
  split_key $2; [[ -n $KS && $KP != +pr ]] || exit 0
  print -rn -- "End ${(qq)KS} on $KP? Claude stops and its tmux session closes. [y/N] "
  read -q || { print; exit 0 }
  print
  [[ -n $id ]] && first_key $id $2 && next=$REPLY
  # The viewer moves first, so it is never left on a session that is gone.
  [[ -n $next ]] && $SELF _select $id $next force
  load $KP && on 'tmux kill-session -t "=$1"' $KS
  [[ -n $next ]] && $SELF _pos $id $FZF_PORT $next >/dev/null 2>&1 &!
  ;;

_tab)  # _tab ID KEY: the session in a new Ghostty tab (in the tmux layout: switch the viewer to it)
  split_key $3; [[ -n $KS && $KP != +pr ]] || exit 0
  if [[ $(mode $2) == ghostty ]]; then
    ghostty "set cfg to new surface configuration
      set command of cfg to \"$SELF _attach ${(q)3}\"
      $(genv)
      new tab in front window with configuration cfg" >/dev/null
  else
    $SELF _select $2 $3 force; $SELF _focus $2
  fi
  ;;

_menu)  # _menu ID KEY: the row's menu (right-click, or m): click an action, or move to it and press enter
  local id=$2 key=$3 D=$'\e[90m' E=$'\e[31m' R=$'\e[0m' head line act new pick pr= cur next=
  local -a acts  # ACTION<tab>label
  local name st att age url model dir title branch changed waitfor
  local repo num ptitle purl draft pbranch review checks updated
  split_key $key
  if [[ $KP == +pr && -n $KS ]]; then
    for line in ${(f)"$(<$STATE/prs)"}; do
      IFS=$'\037' read -r repo num ptitle purl draft pbranch review checks updated <<<"$line"
      [[ $purl == $KS ]] && break
    done
    [[ $purl == $KS ]] || exit 0
    head="#$num $ptitle"
    acts=( $'open\topen in the browser' $'checks\topen its checks' $'files\topen its files' $'copy\tcopy its link' )
    [[ -n $pbranch ]] && acts+=( $'copybranch\tcopy its branch' )
    acts+=( $'session\tnew session on '${repo:t} $'review\task Claude to review it' )
    [[ $checks == (FAILURE|ERROR) ]] && acts+=( $'fix\task Claude to fix the failing checks' $'rerun\tre-run the failed checks' )
    [[ $draft == true ]] && acts+=( $'ready\tmark it ready for review' )
    [[ $checks == SUCCESS && $draft != true && $review != (CHANGES_REQUESTED|REVIEW_REQUIRED) ]] &&
      acts+=( "merge"$'\t'"${E}merge it (squash)…$R" )
    acts+=( "close"$'\t'"${E}close it…$R" )
  elif [[ $KP == +pr ]]; then
    head="pull requests"
    acts=( $'all\topen all your pull requests on GitHub' $'refresh\trefresh the list now' )
  elif [[ -z $KS ]]; then
    [[ -e $PROFILES/$KP.conf ]] || exit 0
    head=$KP
    acts=( $'opus\tnew Opus session here' $'sonnet\tnew Sonnet session here'
           $'opencode\tnew opencode session here' $'test\ttest this machine' $'edit\tedit this profile…' "remove"$'\t'"${E}remove this profile…$R" $'reload\trefresh' )
  else
    load $KP || exit 0
    for line in ${(f)"$(<$STATE/raw-$KP)"}; do
      IFS=$'\037' read -r name st att age url model dir title branch changed waitfor <<<"$line"
      [[ $name == $KS ]] && break
    done
    [[ $name == $KS ]] || exit 0
    head=$KS
    acts=( $'view\tview it here' $'focus\tview it and type in it' )
    [[ $(mode $id) == ghostty ]] && acts+=( $'tab\topen it in a new Ghostty tab' )
    [[ -n $url ]] && acts+=( $'rc\topen its Remote Control link' $'copyrc\tcopy its Remote Control link' )
    # Its pull request: one of yours on the same branch, in a repository named like its folder.
    if [[ -n $branch && -s $STATE/prs ]]; then
      for line in "${(@)${(f)"$(<$STATE/prs)"}[2,-1]}"; do
        IFS=$'\037' read -r repo num ptitle purl draft pbranch review checks updated <<<"$line"
        [[ $pbranch == $branch && ${repo:t} == ${dir:t} ]] && { pr=$purl; acts+=( $'pr\topen its pull request #'$num ); break }
      done
    fi
    [[ -n $dir ]] && acts+=( $'github\topen its repository on GitHub' )
    acts+=( $'attach\tcopy the attach command' )
    [[ $P_TYPE == local && -n $dir ]] && acts+=( $'folder\topen its folder' )
    acts+=( $'new\tnew session on this machine' $'newoc\tnew opencode session on this machine' )
    if [[ $st == work ]]; then
      [[ $model == opencode ]] && acts+=( $'esc\tinterrupt it (Esc)' ) || acts+=( $'esc\tinterrupt Claude (Esc)' )
    fi
    acts+=( $'rename\trename it' "end"$'\t'"${E}end it: stop Claude and close its tmux session…$R" )
  fi
  acts+=( "cancel"$'\t'"${D}cancel$R" )
  _cut $head $(( ${COLUMNS:-56} - 3 ))
  pick=$(print -rl -- $acts | fzf --ansi --layout=reverse --no-input --no-sort --delimiter=$'\t' --with-nth=2 \
    --info=hidden --gutter=' ' --pointer='▌' --highlight-line --color='header:bold,pointer:yellow,current-fg:bold' \
    --header=" $REPLY" --header-border=bottom \
    --bind 'left-click:accept,double-click:accept,right-click:abort,q:abort,esc:abort') || exit 0
  act=${pick%%$'\t'*}
  # gh_do WHAT COMMAND...: runs a GitHub change where you can read its answer; the PR list refreshes after it.
  gh_do() { print -r -- "$1 ..."; shift; "$@" 2>&1; rm -f $STATE/prs; print -n "press a key"; read -k1 -s }
  case $act in
    open)  browse $purl ;;
    checks) browse $purl/checks ;;
    files) browse $purl/files ;;
    copy)  clip $purl ;;
    copybranch) clip $pbranch ;;
    session) $SELF _new opus $id +pr/ ${repo:t} ;;
    review) $SELF _new opus $id +pr/ ${repo:t}-pr$num "Review pull request #$num of $repo ($purl). If this folder \
is not a clone of $repo, clone it first. Check it out with gh pr checkout $num, read the diff and the discussion, \
and report what you find, most severe first." ;;
    fix) $SELF _new opus $id +pr/ ${repo:t}-pr$num "The checks of pull request #$num of $repo ($purl) are failing. \
If this folder is not a clone of $repo, clone it first. Check it out with gh pr checkout $num, find out why with \
gh pr checks $num, fix it and push." ;;
    rerun) gh_do "re-running the failed checks of #$num" gh run rerun \
             "$(gh run list --repo $repo --branch $pbranch --status failure -L 1 --json databaseId -q '.[0].databaseId')" \
             --failed --repo $repo ;;
    ready) gh_do "marking #$num ready for review" gh pr ready $num --repo $repo ;;
    merge) print -rn -- "Merge #$num of $repo (squash)? [y/N] "
           read -q && { print; gh_do "merging #$num" gh pr merge $num --repo $repo --squash } ;;
    close) print -rn -- "Close #$num of $repo without merging? [y/N] "
           read -q && { print; gh_do "closing #$num" gh pr close $num --repo $repo } ;;
    all)   browse https://github.com/pulls ;;
    refresh) rm -f $STATE/prs ;;
    opus|sonnet|opencode) $SELF _new $act $id $key ;;
    test)  $SELF profile test $KP; print -n "press a key"; read -k1 -s ;;
    edit)  $SELF profile edit $KP; print -n "press a key"; read -k1 -s ;;
    remove)
      print -rn -- "Remove profile $KP? Its sessions keep running in tmux; the panel stops listing them. [y/N] "
      read -q || { print; exit 0 }
      print
      # The viewer moves first, to the first session of another profile (or to none), so it never stays on a
      # session the panel no longer lists.
      cur=$(<$STATE/$id.target 2>/dev/null)
      if [[ $cur == $KP/* ]]; then
        first_key $id ${(M)${${(@0)"$(<$STATE/$id.cache 2>/dev/null)"}%%$'\t'*}:#$KP/*} && next=$REPLY
        if [[ -n $next ]]; then $SELF _select $id $next force
        else : >$STATE/$id.target; viewer_detach $id $cur; fi
      fi
      $SELF profile remove $KP
      _seen_lock; rm -rf $STATE/raw-$KP $STATE/seen/$KP $STATE/unread/$KP $STATE/down-$KP; _seen_unlock
      [[ -n $next ]] && $SELF _pos $id $FZF_PORT $next >/dev/null 2>&1 &! ;;
    view)  $SELF _select $id $key force ;;
    focus) $SELF _select $id $key force; $SELF _focus $id ;;
    tab)   $SELF _tab $id $key ;;
    rc)    browse $url ;;
    copyrc) clip $url ;;
    pr)    browse $pr ;;
    github)
      line=$(on 'git -C "$1" remote get-url origin 2>/dev/null' $dir)
      line=${${line%.git}/#(git@github.com:|ssh:\/\/git@github.com\/)/https://github.com/}
      [[ $line == https://* ]] && browse $line ;;
    attach)
      if [[ $P_TYPE == local ]]; then clip "tmux attach -t =$KS"
      else clip "ssh ${P_KEY:+-i $P_KEY }${P_PORT:+-p $P_PORT }-t $P_HOST tmux attach -t =$KS"; fi ;;
    folder) browse $dir ;;
    new)   $SELF _new opus $id $key ;;
    newoc) $SELF _new opencode $id $key ;;
    # opencode 2.0 stops only on a second Esc within a few seconds.
    esc)   on 'tmux send-keys -t "=$1:" Escape
             if [ "$2" = opencode ] || [ "$(tmux show-options -qv -t "=$1:" @lzr1_agent)" = opencode ]; then
               sleep 0.3; tmux send-keys -t "=$1:" Escape; fi' $KS $model ;;
    rename)
      read -r "new?Rename $KS to: "
      [[ -z $new || $new == $KS ]] && exit 0
      [[ $new == *[.:/\|]* ]] && { print -r -- 'names cannot contain ".", ":", "/" or "|" — press a key'; read -k1 -s; exit 0 }
      on 'tmux rename-session -t "=$1" "$2"' $KS $new || { print -n "press a key"; read -k1 -s; exit 0 }
      [[ $(<$STATE/$id.target 2>/dev/null) == $key ]] && print -rn -- "$KP/$new" >$STATE/$id.target &&
        remote_last $id "$KP/$new"
      cur=$STATE/$id.target.on
      [[ -r $cur && $(<$cur) == $key ]] && print -rn -- "$KP/$new" >$cur ;;
    end)   $SELF _kill $key $id ;;
  esac
  ;;

_attach)  # _attach KEY
  split_key $2; load $KP || exit 1
  on -t "$CLIP"'unset TMUX; exec tmux attach -t "=$1"' $KS
  ;;

_panel)  # _panel ID
  local id=$2 me
  printf '\e]2;lzr1 panel\a'
  if [[ $(mode $id) == tmux ]]; then
    me=$TMUX_PANE
    print -rn -- $me >$STATE/$id.me
  else
    repeat 20; do [[ -s $STATE/$id.me ]] && break; sleep 0.1; done
    me=$(<$STATE/$id.me 2>/dev/null)
    # Narrow this split to PANEL_W columns: move the divider, measure, correct once.
    if [[ -n $me ]] && (( COLUMNS > PANEL_W + 4 )); then
      local c0=$COLUMNS c1
      ghostty "perform action \"resize_split:left,200\" on (terminal id \"$me\")" >/dev/null; sleep 0.25
      c1=$(tput cols)
      (( c0 > c1 && c1 > PANEL_W )) && ghostty "perform action \"resize_split:left,$(( (c1 - PANEL_W) * 200 / (c0 - c1) ))\" on (terminal id \"$me\")" >/dev/null
    fi
  fi
  local S=$SELF
  # A row's menu opens on the right button (LZR1_MENU_BUTTON=left: on the left one, which then also picks the row).
  local menu="execute($S _menu $id {1})+reload-sync($S _list $id)" button=right-click
  [[ $MENU_BUTTON == left ]] && button=left-click
  # fzf runs a footer click on the button's release, and only when it saw that button's press. A click opens the menu
  # on its press and the menu takes the release, so the next footer click would be lost. In the tmux layout a release
  # typed into the panel once the menu is gone clears that (_unclick); a Ghostty split cannot be typed into.
  [[ $(mode $id) == tmux ]] && menu="execute($S _menu $id {1})+execute-silent($S _unclick $id $me)"
  # Narrow (_fit): the viewer is hidden, so a tap on a session's row shows it (enter's action) instead of only moving the
  # highlight (_tap decides). A hidden panel (1 column behind the zoomed viewer) skips the reload a resize otherwise
  # makes. A row's key ({1}) only ever reaches a command as one argument fzf quotes, never text a shell evaluates: a
  # session's name can hold "$(...)".
  local -a narrow=()
  [[ $button != left-click ]] && narrow=( --bind "left-click:execute-silent($S _tap $id {1})" )
  # The ticker and _pos send reloads through fzf's port, which plain --listen refuses; a per-panel key keeps
  # any other local process from sending commands to it.
  export FZF_API_KEY=$(openssl rand -hex 16)
  fzf --ansi --read0 --no-input --layout=reverse --no-sort --track --id-nth=1 \
    --delimiter=$'\t' --with-nth=2 --header-lines=1 \
    --listen-unsafe --no-scrollbar --info=hidden --pointer='▌' --gutter=' ' --highlight-line \
    --border=none --header-border=bottom --header-label=' lzr1 ' \
    --footer='[+opus] [+sonnet] [+opencode] [↻] [?]' --footer-border=top \
    --color='header:dim,footer:yellow,pointer:yellow,current-fg:bold' \
    --bind "start:reload($S _list $id)+execute-silent($S _ticker $id \$FZF_PORT)" \
    --bind "resize:transform:[ \$FZF_COLUMNS -gt 2 ] && echo 'reload-sync($S _list $id)'" $narrow \
    --bind "focus:execute-silent($S _select $id {1} &)" \
    --bind "enter:execute-silent($S _go $id {1})" \
    --bind "double-click:execute-silent($S _go $id {1})" \
    --bind "$button:$menu" --bind "m:$menu" \
    --bind "t:execute-silent($S _tab $id {1})" \
    --bind "o:execute-silent($S _open_url {1})" \
    --bind "n:execute($S _new opus $id {1})+reload-sync($S _list $id)" \
    --bind "s:execute($S _new sonnet $id {1})+reload-sync($S _list $id)" \
    --bind "c:execute($S _new opencode $id {1})+reload-sync($S _list $id)" \
    --bind "x:execute($S _kill {1} $id)+reload-sync($S _list $id)" \
    --bind "r:reload-sync($S _list $id)" \
    --bind "?:execute($S keys; read -k1 -s)" \
    --bind "q:abort,esc:abort" \
    --bind "click-footer:transform:$S _footer $id"
  # q (or esc) closes the viewer too, so the window closes with the panel.
  $SELF _quit $id
  ;;

_quit)  # _quit ID: close the viewer and, in the tmux layout, the layout itself
  if [[ $(mode $2) == tmux ]]; then
    local tty=$(tmux -L lzr1 list-clients -t lzr1-$2 -F '#{client_tty}' 2>/dev/null | head -1)
    tmux -L lzr1 kill-session -t lzr1-$2 2>/dev/null
    # macOS Terminal keeps a window open after its shell ends ("[Process completed]"): close the one that held the
    # layout, unless it has other tabs.
    if [[ $(<$STATE/$2.term 2>/dev/null) == Apple_Terminal && -n $tty ]]; then
      sleep 0.5
      print -r -- "tell application \"Terminal\"
        repeat with w in windows
          if (count of tabs of w) is 1 and tty of tab 1 of w is \"$tty\" then close w
        end repeat
      end tell" | osascript - >/dev/null 2>&1
    fi
  else
    local vp=$(<$STATE/$2.vpid 2>/dev/null)
    [[ -n $vp ]] && { pkill -TERM -P $vp 2>/dev/null; kill -TERM $vp 2>/dev/null }
  fi
  ;;

keys)
  cat <<'EOF'

  lzr1-panel keys

  click / ↑ ↓      show that session in the viewer
  enter / dbl-click  show it and move the keyboard to the viewer (a PR: open it)
  right-click / m  the row's menu: links, copy, Claude on a PR, rename, end...
  n  or [+opus]    new Opus session on the highlighted row's profile
  s  or [+sonnet]  new Sonnet session (a repository name opens in its folder)
  c  or [+opencode]  new opencode session (auto-approve on)
  t                open the session in a new Ghostty tab
  o                open its Remote Control link (a PR: the PR) in the browser
  x                end the session: Claude and its tmux session (asks first),
                   then the first session left shows
  r  or [↻]        refresh now (it refreshes every 15s)
  q                close the panel and the viewer (the window closes)

  In the viewer: Ctrl-b d leaves a session; Ctrl-C goes to Claude.
  Narrow window: tap a row; the bottom bar: the panel.
  Copy: drag over the text, then Ctrl-C (Cmd-C does not reach Claude). Cmd-V pastes.
  Terminal's own selection: Cmd-R (macOS Terminal) or Shift-drag (Ghostty), then Cmd-C.
  If Claude exits, its session stays: Enter resumes it.

  glyphs: ▶ working  ⧗ waiting on you  · idle  ● a terminal is attached
          ✱ finished or asking since you last looked
  PRs:    ✓ checks passed  ✗ failed or changes requested  ⧗ running or review pending  ◌ draft

  press a key
EOF
  ;;

_notify)  # _notify RECORD...: list_rows' alerts, from a process of its own
  shift; notify_alerts "$@"
  ;;

notify)  # a sample alert, in the foreground, to check the tone and the notifications on this computer
  notify_alerts "question"$'\037'"lzr1-panel"$'\037'"test"$'\037'"this is how a session asks for you"
  ;;

remote)  # remote on [--allow EMAIL[,EMAIL]] [--ttl 8h] | off | status | url | password | build
  shift
  case $1 in
    on)
      shift
      local allow= ttl=${LZR1_REMOTE_TTL:-8h} from=LZR1_REMOTE_TTL idle=${LZR1_REMOTE_IDLE:-30m} a gw uuid pw port
      local n=${LZR1_REMOTE_PWLEN:-16} secs i out
      local use="usage: lzr1-panel remote on [--allow EMAIL[,EMAIL...]] [--ttl 8h] (or LZR1_REMOTE_TTL=8h; LZR1_REMOTE_IDLE=30m)"
      while (( $# )); do
        case $1 in
          --allow|--ttl) (( $# >= 2 )) || die "$use ($1 needs a value)"
            [[ $1 == --allow ]] && allow=$2 || ttl=$2 from=--ttl; shift 2 ;;
          --allow=*) allow=${1#*=}; shift ;;
          --ttl=*) ttl=${1#*=} from=--ttl; shift ;;
          *) die $use ;;
        esac
      done
      [[ $n == <-> ]] && (( n >= 12 )) || die "LZR1_REMOTE_PWLEN must be 12 or more (got $n)"
      _dur $ttl $from; secs=$REPLY  # the TTL in seconds, for the expiry shown
      _dur $idle LZR1_REMOTE_IDLE
      if _remote_live; then _remote_status; die "remote is already on (lzr1-panel remote off turns it off)"; fi
      [[ -e $RDIR/session ]] && die "remote on: the last remote is still published (above)"
      # Tailscale first: nothing starts unless it can publish.
      _ts_info
      [[ $TS_STATE == Running ]] || die "Tailscale is not connected ($TS_STATE): open Tailscale, or run tailscale up"
      (( TS_CERTS > 0 )) && [[ -n $TS_HOST ]] ||
        die "turn on HTTPS in the Tailscale admin console: DNS → HTTPS Certificates (login.tailscale.com/admin/dns)"
      (( $+commands[ttyd] )) || die "remote needs ttyd: brew install ttyd (Linux: apt install ttyd, or github.com/tsl0922/ttyd)"
      (( $+commands[openssl] )) || die "remote needs openssl"
      # Never public: refuse when Funnel is on for this address, or when Tailscale cannot say.
      _remote_funnel $TS_HOST; case $? in
        0) die "Funnel is on for $TS_HOST:443, which would put the panel on the internet: turn it off (tailscale funnel reset)" ;;
        2) die "could not read tailscale serve status --json, so cannot check Funnel is off: not publishing" ;;
      esac
      # Who may open it: Tailscale logins, prefilled with the last answer (the first time: this machine's login).
      if [[ -z $allow ]]; then
        allow=$(sed -n 's/^allow=//p' $CONFIG/remote.conf 2>/dev/null); : ${allow:=$TS_LOGIN}
        if [[ -t 0 ]]; then
          vared -p "Tailscale logins allowed in (comma-separated): " allow || die "remote on: no answer"
        else
          print -rnu2 -- "Tailscale logins allowed in [$allow] "; IFS= read -r a && [[ -n $a ]] && allow=$a
        fi
      fi
      allow=${(j:,:)${(s:,:)${allow//[[:space:]]/}}:l}
      [[ -n $allow ]] || die "remote on: no login allowed in"
      # Tailscale logins: an e-mail, or name@github, name@passkey (no dot after the @).
      for a in ${(s:,:)allow}; do [[ $a == [^@]##@[^@]## ]] || die "not a Tailscale login (like you@example.com): $a"; done
      print -r -- "allow=$allow" >$CONFIG/remote.conf
      _remote_gw; gw=$REPLY
      mkdir -p $RDIR && chmod 700 $RDIR
      rm -f $RDIR/*.sock(N) $RDIR/*.last(N) $RDIR/gw.out $RDIR/gw.pid $RDIR/serve.out $RDIR/serve.pid
      # The audit trail the gateway appends to (0600): its last 2000 lines kept. This remote's events start at auditpos,
      # where the watcher and status read from. Trimmed only here, while no remote runs.
      ( umask 077
        if [[ -f $RDIR/audit.log ]]; then tail -n 2000 $RDIR/audit.log >$RDIR/audit.tmp && mv -f $RDIR/audit.tmp $RDIR/audit.log
        else : >$RDIR/audit.log; fi ) || die "remote on: cannot write $RDIR/audit.log"
      if (( $+commands[uuidgen] )); then uuid=$(uuidgen); else uuid=$(</proc/sys/kernel/random/uuid); fi
      uuid=${uuid:l}
      [[ $uuid == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || die "could not make a UUID"
      # 56 characters with no look-alikes (0/O, 1/l/I), about 5.8 bits each.
      pw=; while (( ${#pw} < n )); do
        pw+=$(openssl rand -base64 48 | tr -dc 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789')
      done
      pw=${pw[1,n]}
      zmodload zsh/datetime
      RS=(uuid $uuid url https://$TS_HOST/$uuid/ password $pw allow $allow started $EPOCHSECONDS
          expires $(( EPOCHSECONDS + secs )) host $TS_HOST idle $idle auditpos $(( $(wc -c <$RDIR/audit.log) )))
      _remote_save
      ( umask 077; : >$RDIR/ttyd.log; : >>$RDIR/remote.log )  # errors, refused logins and paths, never the password
      # A browser gets its own panel in the tmux layout (a Ghostty split cannot be shown in a browser), splash off;
      # LZR1_REMOTE marks its tmux session so it ends with the browser and with remote off.
      ttyd -i $RDIR/ttyd.sock -b /$uuid -W -m 4 -t titleFixed=lzr1 \
        env -u GHOSTTY_RESOURCES_DIR -u TERM_PROGRAM -u TMUX -u TMUX_PANE -u COLUMNS -u LINES \
        LZR1_SPLASH=0 LZR1_REMOTE=$uuid $SELF open </dev/null >$RDIR/ttyd.log 2>&1 &!
      RS[ttydpid]=${!}  # (RS[k]=$! would store "$!" itself)
      _remote_save
      # The password reaches the gateway on its stdin, never in a command line or the environment. Its stdout goes to
      # the keeper, which publishes it and ends serve when the gateway exits. On macOS the app's serve cannot reach a
      # Unix socket, so the gateway listens on 127.0.0.1 there: any local user or process can reach that port and claim
      # any login, so only the password protects it there (docs/remote.md).
      local -a listen=(--listen $RDIR/gw.sock --stripped)
      [[ $OSTYPE == darwin* ]] && listen=(--listen 127.0.0.1:0)
      zmodload zsh/system
      print -r -- $pw | ( print $sysparams[pid] >$RDIR/gw.pid
          exec $gw $listen --host $TS_HOST --upstream $RDIR/ttyd.sock --base /$uuid/ --allow $allow --ttl $ttl \
            --log $RDIR/remote.log --audit $RDIR/audit.log --idle $idle 2>>$RDIR/remote.log ) |
        _remote_keeper $uuid >>$RDIR/remote.log 2>&1 &!
      # gw.pid is written just before the exec, so until then its command line is still this shell's: only a pid that
      # is gone means the gateway died (and after 5 s it has long exec'd, so _remote_off recognizes it to stop it).
      for i in {1..50}; do
        out=; [[ -r $RDIR/gw.out ]] && out=$(<$RDIR/gw.out); [[ $out == ready* ]] && break
        [[ -s $RDIR/gw.pid ]] && ! kill -0 $(<$RDIR/gw.pid) 2>/dev/null && break
        sleep 0.1
      done
      RS[gwpid]=; [[ -r $RDIR/gw.pid ]] && RS[gwpid]=$(<$RDIR/gw.pid)
      [[ $out == "ready 127.0.0.1:"<-> ]] && RS[port]=${out##*:}
      _remote_save
      if [[ $out != ready* ]]; then
        _remote_off
        die "the gateway did not start: ${$(tail -3 $RDIR/remote.log $RDIR/ttyd.log 2>/dev/null)//$'\n'/ }"
      fi
      for i in {1..50}; do [[ -s $RDIR/serve.pid ]] && break; sleep 0.1; done
      RS[servepid]=; [[ -r $RDIR/serve.pid ]] && RS[servepid]=$(<$RDIR/serve.pid)
      _remote_save
      for i in {1..50}; do
        _remote_published $uuid && break
        _ours "$RS[servepid]" serve $uuid || break
        sleep 0.1
      done
      if ! _remote_published $uuid; then
        out=; [[ -r $RDIR/serve.out ]] && out=$(<$RDIR/serve.out)
        _remote_off
        [[ $out == *(#i)(access denied|permission|operator)* ]] &&
          print -ru2 -- "lzr1-panel: serve needs root on Linux, or once: sudo tailscale set --operator=\$USER"
        die "tailscale serve failed: ${${out:-no route after 5 s}//$'\n'/ }"
      fi
      # Checked again now that it is published (Funnel could have been turned on meanwhile), and by the watcher.
      _remote_funnel $TS_HOST; case $? in
        0) _remote_off; die "Funnel is on for $TS_HOST:443, which would put the panel on the internet: turned remote off" ;;
        2) _remote_off; die "could not read tailscale serve status --json to check Funnel: turned remote off" ;;
      esac
      # The watcher, a process of its own whose command line holds the UUID.
      ( trap '' HUP INT; exec $SELF remote watch $uuid ) </dev/null >>$RDIR/remote.log 2>&1 &!
      RS[watchpid]=${!}
      _remote_save
      print -r -- "remote: on, for $allow until $(strftime '%H:%M' $RS[expires]); idle browsers log out after $idle"
      print -r -- "  url:      $RS[url]"
      print -r -- "  password: $pw"
      clip $RS[url]
      print -r -- "copied the URL; lzr1-panel remote password copies the password, lzr1-panel remote off ends it"
      ;;
    off)
      if _remote_read; then _remote_off || exit 1; print "remote: off (unpublished, stopped)"
      else _remote_off; print "remote: off"; fi
      ;;
    status|'') _remote_status ;;
    url) _remote_live || die "remote is off"; clip $RS[url]; print -r -- "copied the URL: $RS[url]" ;;
    password) _remote_live || die "remote is off"; clip $RS[password]; print "copied the password" ;;
    build) _remote_gw; print -r -- "gateway: $REPLY" ;;
    watch) [[ $2 == [0-9a-f](#c8)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c4)-[0-9a-f](#c12) ]] || die "usage: lzr1-panel remote watch UUID (internal)"
      _remote_watch $2 ;;
    *) die "usage: lzr1-panel remote on [--allow EMAIL[,EMAIL...]] [--ttl 8h] | off | status | url | password (LZR1_REMOTE_TTL, LZR1_REMOTE_IDLE, LZR1_REMOTE_NOTIFY: docs/remote.md)" ;;
  esac
  ;;

splash) lzr1_splash ${2:+${2#--}} ;;

version|--version) print -r -- "lzr1-panel $VERSION" ;;

*)
  sed -n '1d; /^#/!q; p' $SELF | sed 's/^# \{0,1\}//'  # the header comment, however long
  [[ -z $1 || $1 == (help|-h|--help) ]] || exit 1
  ;;
esac
